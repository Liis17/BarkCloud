<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="barkcloud_pending_registration.xml"/>
        <exclude domain="sharedpref" path="barkcloud_android_updates.xml"/>
        <exclude domain="external" path="updates/"/>
        <!-- TODO: Use <include> and <exclude> to control what is backed up.
        <include .../>
        <exclude .../>
        -->
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="barkcloud_pending_registration.xml"/>
        <exclude domain="sharedpref" path="barkcloud_android_updates.xml"/>
        <exclude domain="external" path="updates/"/>
    </device-transfer>
    <!--
    <device-transfer>
        <include .../>
        <exclude .../>
    </device-transfer>
    -->
</data-extraction-rules>
