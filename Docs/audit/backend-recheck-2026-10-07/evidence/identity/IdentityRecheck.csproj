<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <BarkCloudRoot Condition="'$(BarkCloudRoot)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../../../../'))</BarkCloudRoot>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(BarkCloudRoot)/Backend/BarkCloud.Identity/BarkCloud.Identity.csproj" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <Compile Include="$(BarkCloudRoot)/Tests/Backend/BarkCloud.Identity.Tests/_Helpers/UserContextFactory.cs" Link="UserContextFactory.cs" />
  </ItemGroup>
</Project>
