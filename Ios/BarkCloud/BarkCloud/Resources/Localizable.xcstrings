      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При запуске и возврате после 30 секунд в фоне будет запрошен Face ID. После трёх неверных попыток PIN все локальные данные будут стёрты."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face ID will be requested on launch and when returning after 30 seconds in the background. After three wrong PIN attempts all local data will be erased."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face ID wird beim Start und bei der Rückkehr nach 30 Sekunden im Hintergrund abgefragt. Nach drei falschen PIN-Eingaben werden alle lokalen Daten gelöscht."
          }
        }
      }
