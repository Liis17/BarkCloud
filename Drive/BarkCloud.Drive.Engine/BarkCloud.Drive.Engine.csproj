<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- WinExe: фоновый процесс без окна / без панели задач / без Alt-Tab -->
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>BarkCloud.Drive.Engine</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="DokanNet" Version="2.3.0.3" />
        <PackageReference Include="Google.Protobuf" Version="3.35.0" />
        <PackageReference Include="Grpc.Net.Client" Version="2.80.0" />
        <PackageReference Include="Grpc.Tools" Version="2.80.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="StreamJsonRpc" Version="2.24.92" />
        <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.8" />
    </ItemGroup>

    <ItemGroup>
        <Protobuf Include="..\..\Shared\BarkCloud.Proto\shared.proto" GrpcServices="None" />
        <Protobuf Include="..\..\Shared\BarkCloud.Proto\files_api.proto" GrpcServices="Client" />
        <Protobuf Include="..\..\Shared\BarkCloud.Proto\identity_api.proto" GrpcServices="Client" />
        <Protobuf Include="..\..\Shared\BarkCloud.Proto\users_api.proto" GrpcServices="Client" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\BarkCloud.Drive.Contracts\BarkCloud.Drive.Contracts.csproj" />
    </ItemGroup>

    <ItemGroup>
        <None Update="appsettings.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

</Project>
