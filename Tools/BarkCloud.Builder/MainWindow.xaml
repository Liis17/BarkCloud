<ui:FluentWindow x:Class="BarkCloud.Builder.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:local="clr-namespace:BarkCloud.Builder"
                 mc:Ignorable="d"
                 Title="BarkCloud Builder"
                 Width="780" Height="880"
                 MinWidth="620" MinHeight="520"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowStartupLocation="CenterScreen">

    <ui:FluentWindow.Resources>
        <local:InverseBoolConverter x:Key="InverseBool" />
        <local:AnyEmptyToBoolConverter x:Key="AnyEmpty" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,10,0,2" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="LoggingCheckBox" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <DataTemplate x:Key="AgentTokenTemplate">
            <ui:TextBox Text="{Binding Token, UpdateSourceTrigger=PropertyChanged}" ClearButtonEnabled="False" />
        </DataTemplate>
        <DataTemplate x:Key="AgentSpoolTemplate">
            <ui:TextBox Text="{Binding SpoolPath, UpdateSourceTrigger=PropertyChanged}" ClearButtonEnabled="False" />
        </DataTemplate>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="BarkCloud Builder — генератор docker-compose">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="Box24" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16,8,16,8">
            <StackPanel>

                <!-- Сервисы -->
                <ui:Card Margin="0,0,0,8" Padding="16">
                    <StackPanel>
                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="Сервисы в compose" />
                        <TextBlock Margin="0,2,0,10"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Text="Ядро (configuration, identity, users, files) и web включаются всегда. Остальное — по выбору." />
                        <UniformGrid Columns="2">
                            <ui:ToggleSwitch x:Name="NginxToggle" Margin="0,4" Content="Использовать nginx" IsChecked="{Binding UseNginx}" />
                            <ui:ToggleSwitch x:Name="NotificationToggle" Margin="0,4" Content="notification (SMTP)" IsChecked="{Binding IncludeNotification}" />
                            <ui:ToggleSwitch x:Name="MinioToggle" Margin="0,4" Content="minio (хранилище)" IsChecked="{Binding IncludeMinio}" />
                            <ui:ToggleSwitch x:Name="RabbitToggle" Margin="0,4" Content="rabbitmq (очередь)" IsChecked="{Binding IncludeRabbitmq}" />
                            <ui:ToggleSwitch x:Name="PostgresToggle" Margin="0,4" Content="postgres (БД)" IsChecked="{Binding IncludePostgres}" />
                            <ui:ToggleSwitch x:Name="SeqToggle" Margin="0,4" Content="seq (канал логов)" IsChecked="{Binding IncludeSeq}" Click="OnIncludeSeqClick" />
                            <ui:ToggleSwitch x:Name="LognaraToggle" Margin="0,4" Content="Lognara relay и агенты" IsChecked="{Binding IncludeLognara}" Click="OnIncludeLognaraClick" />
                            <ui:ToggleSwitch x:Name="TorrentToggle" Margin="0,4" Content="torrent (загрузка торрентов)" IsChecked="{Binding IncludeTorrent}" />
                        </UniformGrid>

                        <ui:InfoBar Margin="0,10,0,0" Severity="Warning" IsClosable="False"
                                    IsOpen="{Binding IsChecked, ElementName=NginxToggle, Converter={StaticResource InverseBool}}"
                                    Title="nginx отключён"
                                    Message="Без nginx конфигурация не включает TLS reverse-proxy. Внешние клиенты должны подключаться к сервисам через другой настроенный proxy." />
                        <ui:InfoBar Margin="0,10,0,0" Severity="Error" IsClosable="False"
                                    IsOpen="{Binding IsChecked, ElementName=MinioToggle, Converter={StaticResource InverseBool}}"
                                    Title="MinIO отключён"
                                    Message="Хранилище нужно поднять отдельно, вручную отредактировать .env и прописать его параметры в базе Configuration." />
                        <ui:InfoBar Margin="0,8,0,0" Severity="Warning" IsClosable="False"
                                    IsOpen="{Binding IsChecked, ElementName=RabbitToggle, Converter={StaticResource InverseBool}}"
                                    Title="RabbitMQ отключён"
                                    Message="Брокер нужно поднять отдельно и вручную прописать его параметры в базе Configuration." />
                        <ui:InfoBar Margin="0,8,0,0" Severity="Error" IsClosable="False"
                                    IsOpen="{Binding IsChecked, ElementName=PostgresToggle, Converter={StaticResource InverseBool}}"
                                    Title="PostgreSQL отключён"
                                    Message="Если отключить PostgreSQL, придётся вручную отредактировать .env и поднять/настроить базу данных, прописав подключение в Configuration." />
                        <ui:InfoBar Margin="0,8,0,0" Severity="Error" IsClosable="False"
                                    IsOpen="{Binding IsChecked, ElementName=SeqToggle, Converter={StaticResource InverseBool}}"
                                    Title="Seq отключён"
                                    Message="Канал Seq выключен. Включите Seq и выберите сервисы в таблице логирования, если нужен этот приёмник." />
                    </StackPanel>
                </ui:Card>

                <ui:Card Margin="0,0,0,8" Padding="16">
                    <StackPanel>
                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="Логирование приложений" />
                        <TextBlock Margin="0,2,0,8" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Text="Console, Seq и Lognara управляются независимо. Глобальные переключатели Seq и Lognara сначала меняют канал у всех сервисов; затем можно настроить строки отдельно. Токены и spool используются только для активных Lognara-агентов." />
                        <ui:InfoBar Margin="0,0,0,8" Severity="Warning" IsClosable="False"
                                    IsOpen="{Binding LegacySeqConfigurationUnknown}"
                                    Title="Старый Seq-настройки не содержали app-флаги"
                                    Message="Импорт не подключается к Configuration и не может проверить прежние настройки Seq. Включите Seq и нужные строки, если старые приложения отправляли туда логи; недоступный backend автоматически не назначается." />
                        <DataGrid x:Name="ApplicationLoggingGrid" ItemsSource="{Binding LognaraApplications}"
                                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                  HeadersVisibility="Column" RowHeaderWidth="0" MinHeight="210" MaxHeight="360">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Сервис" Binding="{Binding DisplayName}" IsReadOnly="True" Width="125" />
                                <DataGridTemplateColumn Header="Console" Width="65">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate><CheckBox Style="{StaticResource LoggingCheckBox}" IsChecked="{Binding ConsoleOutput, UpdateSourceTrigger=PropertyChanged}" /></DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Seq" Width="50">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate><CheckBox Style="{StaticResource LoggingCheckBox}" IsChecked="{Binding SeqEnable, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding DataContext.IncludeSeq, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" /></DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Lognara" Width="68">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate><CheckBox Style="{StaticResource LoggingCheckBox}" IsChecked="{Binding LognaraEnable, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding DataContext.IncludeLognara, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" /></DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Agent token" CellTemplate="{StaticResource AgentTokenTemplate}" Width="180" />
                                <DataGridTemplateColumn Header="Agent spool path (пусто — named volume)" CellTemplate="{StaticResource AgentSpoolTemplate}" Width="300" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </ui:Card>

                <ui:CardExpander Margin="0,0,0,8" Icon="{ui:SymbolIcon Server24}">
                    <ui:CardExpander.Header>
                        <StackPanel>
                            <TextBlock FontWeight="Medium" Text="Docker-сеть и имена контейнеров" />
                            <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="Имена контейнеров для Docker и внешних инструментов; service keys cloud-* остаются прежними" />
                        </StackPanel>
                    </ui:CardExpander.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="DOCKER_NETWORK_NAME (должна существовать до запуска)" />
                        <ui:TextBox Text="{Binding DockerNetworkName, UpdateSourceTrigger=PropertyChanged}" />
                        <UniformGrid Margin="0,4,0,0" Columns="2">
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="CONFIGURATION_CONTAINER_NAME" />
                                <ui:TextBox x:Name="ConfigurationNameBox" Text="{Binding ConfigurationContainerName, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="8,0,0,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="IDENTITY_CONTAINER_NAME" />
                                <ui:TextBox x:Name="IdentityNameBox" Text="{Binding IdentityContainerName, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="USERS_CONTAINER_NAME" />
                                <ui:TextBox x:Name="UsersNameBox" Text="{Binding UsersContainerName, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="8,0,0,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="FILES_CONTAINER_NAME" />
                                <ui:TextBox x:Name="FilesNameBox" Text="{Binding FilesContainerName, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="NOTIFICATION_CONTAINER_NAME" />
                                <ui:TextBox x:Name="NotificationNameBox" Text="{Binding NotificationContainerName, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="8,0,0,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="TORRENT_CONTAINER_NAME" />
                                <ui:TextBox x:Name="TorrentNameBox" Text="{Binding TorrentContainerName, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="WEB_CONTAINER_NAME" />
                                <ui:TextBox x:Name="WebNameBox" Text="{Binding WebContainerName, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="8,0,0,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="MINIO_CONTAINER_NAME" />
                                <ui:TextBox x:Name="MinioNameBox" Text="{Binding MinioContainerName, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="RABBITMQ_CONTAINER_NAME" />
                                <ui:TextBox x:Name="RabbitNameBox" Text="{Binding RabbitmqContainerName, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="8,0,0,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="POSTGRES_CONTAINER_NAME" />
                                <ui:TextBox x:Name="PostgresNameBox" Text="{Binding PostgresContainerName, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="SEQ_CONTAINER_NAME" />
                                <ui:TextBox x:Name="SeqNameBox" Text="{Binding SeqContainerName, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="8,0,0,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="NGINX_CONTAINER_NAME (только compose nginx)" />
                                <ui:TextBox x:Name="NginxNameBox" Text="{Binding NginxContainerName, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </ui:CardExpander>

                <!-- Общие -->
                <ui:CardExpander Margin="0,0,0,8" Icon="{ui:SymbolIcon Settings24}" IsExpanded="True">
                    <ui:CardExpander.Header>
                        <StackPanel>
                            <TextBlock FontWeight="Medium" Text="Общие" />
                            <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="Окружение и bootstrap-ключ" />
                        </StackPanel>
                    </ui:CardExpander.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="ASPNETCORE_ENVIRONMENT" />
                        <ComboBox SelectedValue="{Binding AspNetCoreEnvironment, Mode=TwoWay}" SelectedValuePath="Content">
                            <ComboBoxItem Content="Production" />
                            <ComboBoxItem Content="Development" />
                        </ComboBox>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Выбранное имя контейнера Configuration" />
                        <ui:TextBox x:Name="ConfigurationContainerPreviewBox" IsReadOnly="True" ClearButtonEnabled="False"
                                    Text="{Binding Text, ElementName=ConfigurationNameBox, Mode=OneWay}" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Внутренний gRPC-адрес выбранного контейнера" />
                        <ui:TextBox x:Name="ConfigurationAddressPreviewBox" IsReadOnly="True" ClearButtonEnabled="False">
                            <ui:TextBox.Text>
                                <MultiBinding Mode="OneWay" StringFormat="http://{0}:{1}">
                                    <Binding ElementName="ConfigurationNameBox" Path="Text" />
                                    <Binding ElementName="ConfigPortBox" Path="Text" />
                                </MultiBinding>
                            </ui:TextBox.Text>
                        </ui:TextBox>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="CONFIGURATION_SERVICE_URL (стабильный service DNS)" />
                        <ui:TextBox x:Name="ConfigurationServiceUrlBox" IsReadOnly="True" ClearButtonEnabled="False"
                                    Text="{Binding Text, ElementName=ConfigPortBox, Mode=OneWay, StringFormat='http://cloud-configuration:{0}'}" />

                        <TextBlock Style="{StaticResource FieldLabel}" Text="CONFIGURATION_ACCESS_KEY (одинаковый у всех сервисов)" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox x:Name="AccessKeyBox" Grid.Column="0"
                                        Text="{Binding ConfigurationAccessKey, UpdateSourceTrigger=PropertyChanged}" />
                            <ui:Button Grid.Column="1" Margin="8,0,0,0" Content="Случайный"
                                       Icon="{ui:SymbolIcon ArrowSync24}" Tag="50"
                                       CommandParameter="{Binding ElementName=AccessKeyBox}" Click="OnRandom" />
                        </Grid>
                    </StackPanel>
                </ui:CardExpander>

                <!-- Образы -->
                <ui:CardExpander Margin="0,0,0,8" Icon="{ui:SymbolIcon Box24}">
                    <ui:CardExpander.Header>
                        <StackPanel>
                            <TextBlock FontWeight="Medium" Text="Образы" />
                            <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="Реестр и канал docker-образов" />
                        </StackPanel>
                    </ui:CardExpander.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Реестр" />
                        <ui:TextBox IsReadOnly="True" ClearButtonEnabled="False" Text="docker.barkfluff.com" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Канал" />
                        <ComboBox SelectedValue="{Binding ImageChannel, Mode=TwoWay}" SelectedValuePath="Tag">
                            <ComboBoxItem Content="Релиз — barkcloud-*:latest" Tag="Release" />
                            <ComboBoxItem Content="Ночной — barkcloud-*-nightly:latest" Tag="Nightly" />
                            <ComboBoxItem Content="Дев — barkcloud-*-dev:latest" Tag="Dev" />
                        </ComboBox>
                    </StackPanel>
                </ui:CardExpander>

                <!-- MinIO -->
                <ui:CardExpander Margin="0,0,0,8" Icon="{ui:SymbolIcon Storage24}"
                                 Visibility="{Binding IsChecked, ElementName=MinioToggle, Converter={StaticResource BoolToVis}}">
                    <ui:CardExpander.Header>
                        <StackPanel>
                            <TextBlock FontWeight="Medium" Text="MinIO" />
                            <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="S3-совместимое хранилище файлов" />
                        </StackPanel>
                    </ui:CardExpander.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="MINIO_ROOT_USER" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox x:Name="MinioUserBox" Grid.Column="0" Text="{Binding MinioRootUser, UpdateSourceTrigger=PropertyChanged}" />
                            <ui:Button Grid.Column="1" Margin="8,0,0,0" Content="Случайно" Icon="{ui:SymbolIcon ArrowSync24}"
                                       Tag="12" CommandParameter="{Binding ElementName=MinioUserBox}" Click="OnRandom" />
                        </Grid>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="MINIO_ROOT_PASSWORD" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox x:Name="MinioPassBox" Grid.Column="0" Text="{Binding MinioRootPassword, UpdateSourceTrigger=PropertyChanged}" />
                            <ui:Button Grid.Column="1" Margin="8,0,0,0" Content="Случайно" Icon="{ui:SymbolIcon ArrowSync24}"
                                       Tag="20" CommandParameter="{Binding ElementName=MinioPassBox}" Click="OnRandom" />
                        </Grid>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Выбранное имя контейнера MinIO" />
                        <ui:TextBox x:Name="MinioContainerPreviewBox" IsReadOnly="True" ClearButtonEnabled="False" Text="{Binding Text, ElementName=MinioNameBox, Mode=OneWay}" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="S3 API в Docker-сети" />
                        <ui:TextBox x:Name="MinioApiAddressPreviewBox" IsReadOnly="True" ClearButtonEnabled="False">
                            <ui:TextBox.Text>
                                <MultiBinding Mode="OneWay" StringFormat="http://{0}:{1}">
                                    <Binding ElementName="MinioNameBox" Path="Text" />
                                    <Binding ElementName="MinioPortBox" Path="Text" />
                                </MultiBinding>
                            </ui:TextBox.Text>
                        </ui:TextBox>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="MinIO Console в Docker-сети" />
                        <ui:TextBox x:Name="MinioConsoleAddressPreviewBox" IsReadOnly="True" ClearButtonEnabled="False">
                            <ui:TextBox.Text>
                                <MultiBinding Mode="OneWay" StringFormat="http://{0}:{1}">
                                    <Binding ElementName="MinioNameBox" Path="Text" />
                                    <Binding ElementName="MinioWebPortBox" Path="Text" />
                                </MultiBinding>
                            </ui:TextBox.Text>
                        </ui:TextBox>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="MINIO_DATA_PATH (пусто — named volume)" />
                        <ui:TextBox PlaceholderText="./data/minio" Text="{Binding MinioDataPath, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </ui:CardExpander>

                <!-- Files — временные архивы -->
                <ui:CardExpander Margin="0,0,0,8" Icon="{ui:SymbolIcon FolderOpen24}">
                    <ui:CardExpander.Header>
                        <StackPanel>
                            <TextBlock FontWeight="Medium" Text="Файлы — временные архивы" />
                            <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="Папка для сборки ZIP при скачивании папок/альбомов" />
                        </StackPanel>
                    </ui:CardExpander.Header>
                    <StackPanel>
                        <ui:InfoBar Margin="0,0,0,4" Severity="Warning" IsClosable="False" IsOpen="True"
                                    Title="Нужны права на запись"
                                    Message="Сервис files работает не от root (uid 1654). Named volume (пусто) создаётся под root и недоступен на запись — при скачивании архивом будет «Access denied». Укажите внешнюю папку, доступную на запись для uid 1654." />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Выбранное имя контейнера Files" />
                        <ui:TextBox x:Name="FilesContainerPreviewBox" IsReadOnly="True" ClearButtonEnabled="False" Text="{Binding Text, ElementName=FilesNameBox, Mode=OneWay}" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Внутренний gRPC-адрес Files" />
                        <ui:TextBox x:Name="FilesGrpcAddressPreviewBox" IsReadOnly="True" ClearButtonEnabled="False">
                            <ui:TextBox.Text>
                                <MultiBinding Mode="OneWay" StringFormat="http://{0}:{1}">
                                    <Binding ElementName="FilesNameBox" Path="Text" />
                                    <Binding ElementName="FilesPortBox" Path="Text" />
                                </MultiBinding>
                            </ui:TextBox.Text>
                        </ui:TextBox>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Внутренний HTTP/1-адрес Files" />
                        <ui:TextBox x:Name="FilesHttpAddressPreviewBox" IsReadOnly="True" ClearButtonEnabled="False">
                            <ui:TextBox.Text>
                                <MultiBinding Mode="OneWay" StringFormat="http://{0}:{1}">
                                    <Binding ElementName="FilesNameBox" Path="Text" />
                                    <Binding ElementName="FilesHttp1PortBox" Path="Text" />
                                </MultiBinding>
                            </ui:TextBox.Text>
                        </ui:TextBox>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="ARCHIVE_TEMP_PATH (пусто — named volume archive_temp)" />
                        <ui:TextBox PlaceholderText="./data/archive-temp" Text="{Binding ArchiveTempPath, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </ui:CardExpander>

                <!-- RabbitMQ -->
                <ui:CardExpander Margin="0,0,0,8" Icon="{ui:SymbolIcon Mail24}">
                    <ui:CardExpander.Header>
                        <StackPanel>
                            <TextBlock FontWeight="Medium" Text="RabbitMQ" />
                            <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="Брокер сообщений" />
                        </StackPanel>
                    </ui:CardExpander.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="RABBITMQ_DEFAULT_USER" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox x:Name="RabbitUserBox" Grid.Column="0" Text="{Binding RabbitUser, UpdateSourceTrigger=PropertyChanged}" />
                            <ui:Button Grid.Column="1" Margin="8,0,0,0" Content="Случайно" Icon="{ui:SymbolIcon ArrowSync24}"
                                       Tag="12" CommandParameter="{Binding ElementName=RabbitUserBox}" Click="OnRandom" />
                        </Grid>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="RABBITMQ_DEFAULT_PASS" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox x:Name="RabbitPassBox" Grid.Column="0" Text="{Binding RabbitPass, UpdateSourceTrigger=PropertyChanged}" />
                            <ui:Button Grid.Column="1" Margin="8,0,0,0" Content="Случайно" Icon="{ui:SymbolIcon ArrowSync24}"
                                       Tag="20" CommandParameter="{Binding ElementName=RabbitPassBox}" Click="OnRandom" />
                        </Grid>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Выбранное имя контейнера RabbitMQ" />
                        <ui:TextBox x:Name="RabbitContainerPreviewBox" IsReadOnly="True" ClearButtonEnabled="False" Text="{Binding Text, ElementName=RabbitNameBox, Mode=OneWay}" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Внутренний AMQP-адрес" />
                        <ui:TextBox x:Name="RabbitAddressPreviewBox" IsReadOnly="True" ClearButtonEnabled="False">
                            <ui:TextBox.Text>
                                <MultiBinding Mode="OneWay" StringFormat="amqp://{0}:{1}">
                                    <Binding ElementName="RabbitNameBox" Path="Text" />
                                    <Binding ElementName="RabbitPortBox" Path="Text" />
                                </MultiBinding>
                            </ui:TextBox.Text>
                        </ui:TextBox>
                    </StackPanel>
                </ui:CardExpander>

                <!-- PostgreSQL -->
                <ui:CardExpander Margin="0,0,0,8" Icon="{ui:SymbolIcon Database24}"
                                 Visibility="{Binding IsChecked, ElementName=PostgresToggle, Converter={StaticResource BoolToVis}}">
                    <ui:CardExpander.Header>
                        <StackPanel>
                            <TextBlock FontWeight="Medium" Text="PostgreSQL" />
                            <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="База данных + подключение Configuration" />
                        </StackPanel>
                    </ui:CardExpander.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="POSTGRES_USER" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox x:Name="PostgresUserBox" Grid.Column="0" Text="{Binding PostgresUser, UpdateSourceTrigger=PropertyChanged}" />
                            <ui:Button Grid.Column="1" Margin="8,0,0,0" Content="Случайно" Icon="{ui:SymbolIcon ArrowSync24}"
                                       Tag="12" CommandParameter="{Binding ElementName=PostgresUserBox}" Click="OnRandom" />
                        </Grid>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="POSTGRES_PASSWORD" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox x:Name="PostgresPassBox" Grid.Column="0" Text="{Binding PostgresPassword, UpdateSourceTrigger=PropertyChanged}" />
                            <ui:Button Grid.Column="1" Margin="8,0,0,0" Content="Случайно" Icon="{ui:SymbolIcon ArrowSync24}"
                                       Tag="20" CommandParameter="{Binding ElementName=PostgresPassBox}" Click="OnRandom" />
                        </Grid>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="POSTGRES_DB" />
                        <ui:TextBox Margin="0,0,0,6" Text="{Binding PostgresDb, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Выбранное имя контейнера PostgreSQL" />
                        <ui:TextBox x:Name="PostgresContainerPreviewBox" IsReadOnly="True" ClearButtonEnabled="False" Text="{Binding Text, ElementName=PostgresNameBox, Mode=OneWay}" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Внутренний адрес PostgreSQL" />
                        <ui:TextBox x:Name="PostgresAddressPreviewBox" IsReadOnly="True" ClearButtonEnabled="False">
                            <ui:TextBox.Text>
                                <MultiBinding Mode="OneWay" StringFormat="postgresql://{0}:{1}">
                                    <Binding ElementName="PostgresNameBox" Path="Text" />
                                    <Binding ElementName="PostgresPortBox" Path="Text" />
                                </MultiBinding>
                            </ui:TextBox.Text>
                        </ui:TextBox>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="POSTGRES_DATA_PATH (пусто — named volume)" />
                        <ui:TextBox Margin="0,0,0,6" PlaceholderText="./data/pgdata" Text="{Binding PostgresDataPath, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="BACKUP_PATH (пусто — named volume)" />
                        <ui:TextBox PlaceholderText="./data/pgbackup" Text="{Binding BackupPath, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </ui:CardExpander>

                <!-- Порты сервисов -->
                <ui:CardExpander Margin="0,0,0,8" Icon="{ui:SymbolIcon Server24}">
                    <ui:CardExpander.Header>
                        <StackPanel>
                            <TextBlock FontWeight="Medium" Text="Порты сервисов" />
                            <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="Внутренние и внешние порты приложений; фиксированные порты ниже" />
                        </StackPanel>
                    </ui:CardExpander.Header>
                    <StackPanel>
                        <ui:InfoBar Margin="0,0,0,4" Severity="Informational" IsClosable="False" IsOpen="True"
                                    Title="Публикация портов"
                                    Message="Compose nginx публикует HTTPS 443 и API-порты Identity, Users, Files и Torrent с теми же номерами. Configuration и инфраструктурные порты доступны внутри сети; HTTP/1, BitTorrent и Web listener не имеют отдельных host-публикаций. Консоли можно открыть через nginx ниже." />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="IDENTITY_PORT (внутренний gRPC; тот же порт nginx)" />
                        <ui:TextBox x:Name="IdentityPortBox" Margin="0,0,0,6" Text="{Binding IdentityPort, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Выбранное имя контейнера Identity" />
                        <ui:TextBox x:Name="IdentityContainerPreviewBox" IsReadOnly="True" ClearButtonEnabled="False" Text="{Binding Text, ElementName=IdentityNameBox, Mode=OneWay}" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Внутренний gRPC-адрес" />
                        <ui:TextBox x:Name="IdentityAddressPreviewBox" IsReadOnly="True" ClearButtonEnabled="False">
                            <ui:TextBox.Text>
                                <MultiBinding Mode="OneWay" StringFormat="http://{0}:{1}">
                                    <Binding ElementName="IdentityNameBox" Path="Text" />
                                    <Binding ElementName="IdentityPortBox" Path="Text" />
                                </MultiBinding>
                            </ui:TextBox.Text>
                        </ui:TextBox>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="USERS_PORT" />
                        <ui:TextBox x:Name="UsersPortBox" Margin="0,0,0,6" Text="{Binding UsersPort, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Выбранное имя контейнера Users" />
                        <ui:TextBox x:Name="UsersContainerPreviewBox" IsReadOnly="True" ClearButtonEnabled="False" Text="{Binding Text, ElementName=UsersNameBox, Mode=OneWay}" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Внутренний gRPC-адрес" />
                        <ui:TextBox x:Name="UsersAddressPreviewBox" IsReadOnly="True" ClearButtonEnabled="False">
                            <ui:TextBox.Text>
                                <MultiBinding Mode="OneWay" StringFormat="http://{0}:{1}">
                                    <Binding ElementName="UsersNameBox" Path="Text" />
                                    <Binding ElementName="UsersPortBox" Path="Text" />
                                </MultiBinding>
                            </ui:TextBox.Text>
                        </ui:TextBox>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="CONFIGURATION_PORT (порт запуска; доступен только в docker-сети)" />
                        <ui:TextBox x:Name="ConfigPortBox" Margin="0,0,0,6" Text="{Binding ConfigurationPort, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="FILES_PORT" />
                        <ui:TextBox x:Name="FilesPortBox" Margin="0,0,0,6" Text="{Binding FilesPort, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="FILES_HTTP1PORT" />
                        <ui:TextBox x:Name="FilesHttp1PortBox" Text="{Binding FilesHttp1Port, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="TORRENT_PORT (gRPC; тот же порт nginx)" />
                        <ui:TextBox x:Name="TorrentPortBox" Margin="0,0,0,6" Text="{Binding TorrentPort, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="TORRENT_HTTP1PORT (стриминг файлов внутри сети)" />
                        <ui:TextBox x:Name="TorrentHttp1PortBox" Margin="0,0,0,6" Text="{Binding TorrentHttp1Port, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="TORRENT_PEER_PORT (BitTorrent TCP+UDP; не публикуется этим compose)" />
                        <ui:TextBox x:Name="TorrentPeerPortBox" Text="{Binding TorrentPeerPort, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Margin="0,12,0,0" FontWeight="Medium" Text="Фиксированные внутренние порты" />
                        <TextBlock Margin="0,0,0,6" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="Только для адресов контейнеров; не публикуются напрямую на хост." />
                        <UniformGrid Columns="2">
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="MINIO_PORT (API)" />
                                <ui:TextBox x:Name="MinioPortBox" IsReadOnly="True" ClearButtonEnabled="False" Text="{Binding MinioPort, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel Margin="8,0,0,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="MINIO_WEBPORT (консоль)" />
                                <ui:TextBox x:Name="MinioWebPortBox" IsReadOnly="True" ClearButtonEnabled="False" Text="{Binding MinioWebPort, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="RABBITMQ AMQP" />
                                <ui:TextBox x:Name="RabbitPortBox" IsReadOnly="True" ClearButtonEnabled="False" Text="5672" />
                            </StackPanel>
                            <StackPanel Margin="8,0,0,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="POSTGRES_PORT" />
                                <ui:TextBox x:Name="PostgresPortBox" IsReadOnly="True" ClearButtonEnabled="False" Text="{Binding PostgresPort, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="SEQ_WEBPORT" />
                                <ui:TextBox x:Name="SeqWebPortBox" IsReadOnly="True" ClearButtonEnabled="False" Text="{Binding SeqWebPort, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel Margin="8,0,0,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="SEQ_INGESTION_PORT" />
                                <ui:TextBox x:Name="SeqIngestionPortBox" IsReadOnly="True" ClearButtonEnabled="False" Text="5341" />
                            </StackPanel>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="WEB_PORT" />
                                <ui:TextBox x:Name="WebPortBox" IsReadOnly="True" ClearButtonEnabled="False" Text="{Binding WebPort, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel Margin="8,0,0,0">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="HTTPS (nginx)" />
                                <ui:TextBox x:Name="NginxHttpsPortBox" IsReadOnly="True" ClearButtonEnabled="False" Text="443" />
                            </StackPanel>
                        </UniformGrid>

                        <TextBlock Margin="0,12,0,0" FontWeight="Medium" Text="Дополнительные listener-порты nginx" />
                        <TextBlock Margin="0,0,0,6" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="Используются при включённых прокси Seq Console и MinIO Console в разделе Nginx." />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="NGINX_SEQ_PORT (публикуется при включённой консоли)" />
                        <ui:TextBox Margin="0,0,0,6" Text="{Binding NginxSeqPort, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="NGINX_MINIO_CONSOLE_PORT (публикуется при включённой консоли)" />
                        <ui:TextBox Text="{Binding NginxMinioConsolePort, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </ui:CardExpander>

                <!-- Seq -->
                <ui:CardExpander Margin="0,0,0,8" Icon="{ui:SymbolIcon DocumentBulletList24}"
                                 Visibility="{Binding IsChecked, ElementName=SeqToggle, Converter={StaticResource BoolToVis}}">
                    <ui:CardExpander.Header>
                        <StackPanel>
                            <TextBlock FontWeight="Medium" Text="Seq" />
                            <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="Агрегатор логов" />
                        </StackPanel>
                    </ui:CardExpander.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="SEQ_ADMIN_PASSWORD" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox x:Name="SeqPassBox" Grid.Column="0" Text="{Binding SeqAdminPassword, UpdateSourceTrigger=PropertyChanged}" />
                            <ui:Button Grid.Column="1" Margin="8,0,0,0" Content="Случайно" Icon="{ui:SymbolIcon ArrowSync24}"
                                       Tag="20" CommandParameter="{Binding ElementName=SeqPassBox}" Click="OnRandom" />
                        </Grid>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Выбранное имя контейнера Seq" />
                        <ui:TextBox x:Name="SeqContainerPreviewBox" IsReadOnly="True" ClearButtonEnabled="False" Text="{Binding Text, ElementName=SeqNameBox, Mode=OneWay}" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="HTTP Console в Docker-сети" />
                        <ui:TextBox x:Name="SeqConsoleAddressPreviewBox" IsReadOnly="True" ClearButtonEnabled="False">
                            <ui:TextBox.Text>
                                <MultiBinding Mode="OneWay" StringFormat="http://{0}:{1}">
                                    <Binding ElementName="SeqNameBox" Path="Text" />
                                    <Binding ElementName="SeqWebPortBox" Path="Text" />
                                </MultiBinding>
                            </ui:TextBox.Text>
                        </ui:TextBox>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="HTTP ingestion в Docker-сети" />
                        <ui:TextBox x:Name="SeqIngestionAddressPreviewBox" IsReadOnly="True" ClearButtonEnabled="False">
                            <ui:TextBox.Text>
                                <MultiBinding Mode="OneWay" StringFormat="http://{0}:{1}">
                                    <Binding ElementName="SeqNameBox" Path="Text" />
                                    <Binding ElementName="SeqIngestionPortBox" Path="Text" />
                                </MultiBinding>
                            </ui:TextBox.Text>
                        </ui:TextBox>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="SEQ_DATA_PATH (пусто — named volume)" />
                        <ui:TextBox PlaceholderText="./data/seq" Text="{Binding SeqDataPath, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </ui:CardExpander>

                <!-- Lognara -->
                <ui:CardExpander Margin="0,0,0,8" Icon="{ui:SymbolIcon DocumentBulletList24}"
                                 Visibility="{Binding IsChecked, ElementName=LognaraToggle, Converter={StaticResource BoolToVis}}">
                    <ui:CardExpander.Header>
                        <StackPanel>
                            <TextBlock FontWeight="Medium" Text="Lognara" />
                            <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="Локальный relay и отдельные агенты в выбранных контейнерах" />
                        </StackPanel>
                    </ui:CardExpander.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="LOGNARA_CORE_URL (Core endpoint /v1/batches, HTTP или HTTPS)" />
                        <ui:TextBox Text="{Binding LognaraCoreUrl, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="LOGNARA_RELAY_CORE_TOKEN (персональный токен relay из Dock)" />
                        <ui:TextBox Text="{Binding LognaraCoreToken, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="LOGNARA_SERVER" />
                        <ui:TextBox Text="{Binding LognaraServer, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="LOGNARA_BACKEND" />
                        <ui:TextBox Text="{Binding LognaraBackend, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="LOGNARA_ENVIRONMENT (необязательно)" />
                        <ui:TextBox Text="{Binding LognaraEnvironment, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="LOGNARA_AGENT_VERSION (latest или tag релиза)" />
                        <ui:TextBox Text="{Binding LognaraAgentVersion, UpdateSourceTrigger=PropertyChanged}" />
                        <ui:InfoBar Margin="0,8,0,0" Severity="Informational" IsClosable="False" IsOpen="True"
                                    Title="Ручная регистрация и токены"
                                    Message="Создайте relay и отдельный токен для каждого активного агента в Lognara Dock. Builder не регистрирует агентов автоматически. Все агенты отправляют данные во внутренний lognara-relay в сети BarkCloud." />
                        <ui:InfoBar Margin="0,8,0,0" Severity="Warning" IsClosable="False"
                                    IsOpen="{Binding LegacyLognaraImport}"
                                    Title="Импорт старой Lognara-конфигурации"
                                    Message="Старый LOGNARA_RELAY_URL не считается адресом Core и не переносится. Старые токен и spool Configuration сохранены; укажите Core endpoint /v1/batches и новый токен relay." />
                        <TextBlock Margin="0,14,0,0" FontWeight="Medium" Text="Настройки агентов инфраструктуры" />
                        <TextBlock Margin="0,2,0,6" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Text="Токен и spool используются, только если соответствующий сервис включён в compose; для выключенных сервисов эти поля не генерируются и не проверяются." />
                        <DataGrid ItemsSource="{Binding LognaraInfrastructure}" AutoGenerateColumns="False"
                                  CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column"
                                  RowHeaderWidth="0" MinHeight="160" MaxHeight="300">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Сервис" Binding="{Binding DisplayName}" IsReadOnly="True" Width="110" />
                                <DataGridTemplateColumn Header="Agent token" CellTemplate="{StaticResource AgentTokenTemplate}" Width="180" />
                                <DataGridTemplateColumn Header="Agent spool path (пусто — named volume)" CellTemplate="{StaticResource AgentSpoolTemplate}" Width="300" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <ui:InfoBar Margin="0,8,0,0" Severity="Warning" IsClosable="False" IsOpen="True"
                                    Title="Права каталога spool"
                                    Message="Bind-путь должен быть доступен на запись владельцу контейнера (UID 1654 у приложений, root у Web и инфраструктурных образов). Named volumes сохраняют очередь каждого агента отдельно." />
                    </StackPanel>
                </ui:CardExpander>

                <!-- Torrent -->
                <ui:CardExpander Margin="0,0,0,8" Icon="{ui:SymbolIcon ArrowDownload24}"
                                 Visibility="{Binding IsChecked, ElementName=TorrentToggle, Converter={StaticResource BoolToVis}}">
                    <ui:CardExpander.Header>
                        <StackPanel>
                            <TextBlock FontWeight="Medium" Text="Torrent" />
                            <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="Загрузка торрентов на хост-диск" />
                        </StackPanel>
                    </ui:CardExpander.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Выбранное имя контейнера Torrent" />
                        <ui:TextBox x:Name="TorrentContainerPreviewBox" IsReadOnly="True" ClearButtonEnabled="False" Text="{Binding Text, ElementName=TorrentNameBox, Mode=OneWay}" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Внутренний gRPC-адрес Torrent" />
                        <ui:TextBox x:Name="TorrentGrpcAddressPreviewBox" IsReadOnly="True" ClearButtonEnabled="False">
                            <ui:TextBox.Text>
                                <MultiBinding Mode="OneWay" StringFormat="http://{0}:{1}">
                                    <Binding ElementName="TorrentNameBox" Path="Text" />
                                    <Binding ElementName="TorrentPortBox" Path="Text" />
                                </MultiBinding>
                            </ui:TextBox.Text>
                        </ui:TextBox>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Внутренний HTTP/1-адрес Torrent" />
                        <ui:TextBox x:Name="TorrentHttpAddressPreviewBox" IsReadOnly="True" ClearButtonEnabled="False">
                            <ui:TextBox.Text>
                                <MultiBinding Mode="OneWay" StringFormat="http://{0}:{1}">
                                    <Binding ElementName="TorrentNameBox" Path="Text" />
                                    <Binding ElementName="TorrentHttp1PortBox" Path="Text" />
                                </MultiBinding>
                            </ui:TextBox.Text>
                        </ui:TextBox>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="BitTorrent TCP/UDP endpoint (внутри сети)" />
                        <ui:TextBox x:Name="TorrentPeerAddressPreviewBox" IsReadOnly="True" ClearButtonEnabled="False">
                            <ui:TextBox.Text>
                                <MultiBinding Mode="OneWay" StringFormat="{}{0}:{1} (TCP/UDP)">
                                    <Binding ElementName="TorrentNameBox" Path="Text" />
                                    <Binding ElementName="TorrentPeerPortBox" Path="Text" />
                                </MultiBinding>
                            </ui:TextBox.Text>
                        </ui:TextBox>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="TORRENT_DOWNLOAD_PATH (папка на хосте; пусто — named volume)" />
                        <ui:TextBox Margin="0,0,0,6" PlaceholderText="./data/torrent" Text="{Binding TorrentDownloadPath, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="EXTERNAL_TORRENT_HOST (внешний адрес для клиентов)" />
                        <ui:TextBox Text="{Binding ExternalTorrentHost, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </ui:CardExpander>

                <!-- Веб-клиент -->
                <ui:CardExpander Margin="0,0,0,8" Icon="{ui:SymbolIcon Globe24}">
                    <ui:CardExpander.Header>
                        <StackPanel>
                            <TextBlock FontWeight="Medium" Text="Веб-клиент" />
                            <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="BarkCloud.Web" />
                        </StackPanel>
                    </ui:CardExpander.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Выбранное имя контейнера Web" />
                        <ui:TextBox x:Name="WebContainerPreviewBox" IsReadOnly="True" ClearButtonEnabled="False" Text="{Binding Text, ElementName=WebNameBox, Mode=OneWay}" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Внутренний HTTP-адрес Web" />
                        <ui:TextBox x:Name="WebAddressPreviewBox" IsReadOnly="True" ClearButtonEnabled="False">
                            <ui:TextBox.Text>
                                <MultiBinding Mode="OneWay" StringFormat="http://{0}:{1}">
                                    <Binding ElementName="WebNameBox" Path="Text" />
                                    <Binding ElementName="WebPortBox" Path="Text" />
                                </MultiBinding>
                            </ui:TextBox.Text>
                        </ui:TextBox>
                        <ui:ToggleSwitch x:Name="CookieSecureToggle" Margin="0,8,0,0" Content="WEB_COOKIE_SECURE" IsChecked="{Binding WebCookieSecure}" />
                        <ui:InfoBar Margin="0,8,0,0" Severity="Warning" IsClosable="False"
                                    IsOpen="{Binding IsChecked, ElementName=CookieSecureToggle}"
                                    Title="WEB_COOKIE_SECURE = true"
                                    Message="Включайте, если WEB_PUBLIC_HOST доступен браузеру по HTTPS." />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="WEB_PUBLIC_HOST (пусто — из заголовка запроса)" />
                        <ui:TextBox Margin="0,0,0,6" Text="{Binding WebPublicHost, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="WEB_ADMIN_PASSWORD (пусто — раздел «Обслуживание» недоступен)" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox x:Name="WebAdminBox" Grid.Column="0" Text="{Binding WebAdminPassword, UpdateSourceTrigger=PropertyChanged}" />
                            <ui:Button Grid.Column="1" Margin="8,0,0,0" Content="Случайно" Icon="{ui:SymbolIcon ArrowSync24}"
                                       Tag="20" CommandParameter="{Binding ElementName=WebAdminBox}" Click="OnRandom" />
                        </Grid>
                    </StackPanel>
                </ui:CardExpander>

                <!-- Внешние адреса сервисов -->
                <ui:CardExpander Margin="0,0,0,8" Icon="{ui:SymbolIcon Link24}" IsExpanded="True">
                    <ui:CardExpander.Header>
                        <StackPanel>
                            <TextBlock FontWeight="Medium" Text="Внешние адреса сервисов" />
                            <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="Публичные адреса для клиентов (записываются в БД Configuration на чистом старте)" />
                        </StackPanel>
                    </ui:CardExpander.Header>
                    <StackPanel>
                        <ui:InfoBar Margin="0,0,0,4" Severity="Informational" IsClosable="False" IsOpen="True"
                                    Title="Обязательны"
                                    Message="По умолчанию — домен + порт сервиса (как маршрутизирует nginx). Если оставить пусто, Configuration вне Development упадёт при старте." />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="EXTERNAL_IDENTITY_HOST" />
                        <ui:TextBox Margin="0,0,0,6" Text="{Binding ExternalIdentityHost, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="EXTERNAL_USERS_HOST" />
                        <ui:TextBox Margin="0,0,0,6" Text="{Binding ExternalUsersHost, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="EXTERNAL_FILES_HOST" />
                        <ui:TextBox Text="{Binding ExternalFilesHost, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </ui:CardExpander>

                <!-- Почта (SMTP) -->
                <ui:CardExpander Margin="0,0,0,8" Icon="{ui:SymbolIcon Mail24}"
                                 Visibility="{Binding IsChecked, ElementName=NotificationToggle, Converter={StaticResource BoolToVis}}">
                    <ui:CardExpander.Header>
                        <StackPanel>
                            <TextBlock FontWeight="Medium" Text="Почта (SMTP)" />
                            <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="Подтверждение по email — опционально" />
                        </StackPanel>
                    </ui:CardExpander.Header>
                    <StackPanel>
                        <ui:InfoBar Margin="0,0,0,4" Severity="Informational" IsClosable="False" IsOpen="True"
                                    Title="Опционально"
                                    Message="Заполните все 4 поля, чтобы включить подтверждение по email. Если оставить пусто — работа без почты." />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Выбранное имя контейнера Notification" />
                        <ui:TextBox x:Name="NotificationContainerPreviewBox" IsReadOnly="True" ClearButtonEnabled="False" Text="{Binding Text, ElementName=NotificationNameBox, Mode=OneWay}" />
                        <TextBlock Margin="0,0,0,6" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="У Notification нет HTTP/gRPC endpoint; сервис обрабатывает очередь RabbitMQ." />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="EMAIL_HOST" />
                        <ui:TextBox Margin="0,0,0,6" PlaceholderText="smtp.example.com"
                                    Text="{Binding EmailHost, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="EMAIL_PORT" />
                        <ui:TextBox Margin="0,0,0,6" PlaceholderText="587"
                                    Text="{Binding EmailPort, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="EMAIL_SENDER_EMAIL" />
                        <ui:TextBox Margin="0,0,0,6" PlaceholderText="noreply@example.com"
                                    Text="{Binding EmailSenderEmail, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="EMAIL_SENDER_PASSWORD" />
                        <ui:TextBox Text="{Binding EmailSenderPassword, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </ui:CardExpander>

                <!-- Nginx / HTTPS -->
                <ui:CardExpander Margin="0,0,0,8" Icon="{ui:SymbolIcon ShieldLock24}"
                                 Visibility="{Binding IsChecked, ElementName=NginxToggle, Converter={StaticResource BoolToVis}}">
                    <ui:CardExpander.Header>
                        <StackPanel>
                            <TextBlock FontWeight="Medium" Text="Nginx / HTTPS" />
                            <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="Встроенный или внешний reverse-proxy" />
                        </StackPanel>
                    </ui:CardExpander.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Размещение nginx" />
                        <ComboBox x:Name="NginxLocationBox" SelectedValue="{Binding NginxLocation, Mode=TwoWay}" SelectedValuePath="Tag">
                            <ComboBoxItem Content="В составе создаваемого compose" Tag="Compose" />
                            <ComboBoxItem Content="Внешний nginx в общей Docker-сети" Tag="External" />
                        </ComboBox>

                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedValue, ElementName=NginxLocationBox}" Value="External">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <ui:InfoBar Margin="0,8,0,0" Severity="Informational" IsClosable="False" IsOpen="True"
                                        Title="Внешний nginx"
                                        Message="Нужен nginx OSS 1.27.3 или новее. Подключите его к выбранной существующей Docker-сети, установите сгенерированный nginx/cloud.barkfluff.conf в http/conf.d и откройте указанные слушающие порты. Имя и адрес внешнего контейнера задаются отдельно и здесь неизвестны. Builder не перезагружает внешний nginx." />
                        </StackPanel>

                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedValue, ElementName=NginxLocationBox}" Value="Compose">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Выбранное имя контейнера nginx" />
                            <ui:TextBox x:Name="NginxContainerPreviewBox" IsReadOnly="True" ClearButtonEnabled="False" Text="{Binding Text, ElementName=NginxNameBox, Mode=OneWay}" />
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Внутренний HTTPS-адрес nginx" />
                            <ui:TextBox x:Name="NginxAddressPreviewBox" IsReadOnly="True" ClearButtonEnabled="False">
                                <ui:TextBox.Text>
                                    <MultiBinding Mode="OneWay" StringFormat="https://{0}:{1}">
                                        <Binding ElementName="NginxNameBox" Path="Text" />
                                        <Binding ElementName="NginxHttpsPortBox" Path="Text" />
                                    </MultiBinding>
                                </ui:TextBox.Text>
                            </ui:TextBox>
                        </StackPanel>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Внешний домен (server_name)" />
                        <ui:TextBox Text="{Binding NginxDomain, UpdateSourceTrigger=PropertyChanged}" />
                        <ui:InfoBar Margin="0,8,0,0" Severity="Informational" IsClosable="False" IsOpen="True"
                                    Title="Домен панели"
                                    Message="Рекомендуется, чтобы домен совпадал с хостом из WEB_PUBLIC_HOST." />

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Дополнительные HTTPS-прокси" />
                        <ui:ToggleSwitch x:Name="SeqProxyToggle" Margin="0,4" Content="Seq Console" IsChecked="{Binding NginxSeqProxy}"
                                         IsEnabled="{Binding IsChecked, ElementName=SeqToggle}" />
                        <ui:ToggleSwitch x:Name="MinioConsoleProxyToggle" Margin="0,8,0,4" Content="MinIO Console" IsChecked="{Binding NginxMinioConsoleProxy}"
                                         IsEnabled="{Binding IsChecked, ElementName=MinioToggle}" />

                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedValue, ElementName=NginxLocationBox}" Value="Compose">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Сертификат — crt (локальный файл копируется в ./certs)" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBox x:Name="CertCrtBox" Grid.Column="0" IsReadOnly="True"
                                            PlaceholderText="не выбран"
                                            Text="{Binding CertCrtPath, UpdateSourceTrigger=PropertyChanged}" />
                                <ui:Button Grid.Column="1" Margin="8,0,0,0" Content="Выбрать…" Icon="{ui:SymbolIcon FolderOpen24}"
                                           CommandParameter="{Binding ElementName=CertCrtBox}" Click="OnPickCert" />
                            </Grid>

                            <TextBlock Style="{StaticResource FieldLabel}" Text="Ключ — key (локальный файл копируется в ./certs)" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBox x:Name="CertKeyBox" Grid.Column="0" IsReadOnly="True"
                                            PlaceholderText="не выбран"
                                            Text="{Binding CertKeyPath, UpdateSourceTrigger=PropertyChanged}" />
                                <ui:Button Grid.Column="1" Margin="8,0,0,0" Content="Выбрать…" Icon="{ui:SymbolIcon FolderOpen24}"
                                           CommandParameter="{Binding ElementName=CertKeyBox}" Click="OnPickCert" />
                            </Grid>

                            <ui:InfoBar Margin="0,10,0,0" Severity="Warning" IsClosable="False"
                                        Title="Сертификаты не выбраны"
                                        Message="Для запуска nginx нужны оба реальных файла в ./certs. Можно добавить их позже; до этого TLS не запустится.">
                                <ui:InfoBar.IsOpen>
                                    <MultiBinding Converter="{StaticResource AnyEmpty}">
                                        <Binding Path="Text" ElementName="CertCrtBox" />
                                        <Binding Path="Text" ElementName="CertKeyBox" />
                                    </MultiBinding>
                                </ui:InfoBar.IsOpen>
                            </ui:InfoBar>
                        </StackPanel>

                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedValue, ElementName=NginxLocationBox}" Value="External">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Сертификат — полный путь внутри внешнего nginx-контейнера" />
                            <ui:TextBox Text="{Binding ExternalNginxCertificatePath, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Ключ — полный путь внутри внешнего nginx-контейнера" />
                            <ui:TextBox Text="{Binding ExternalNginxKeyPath, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </StackPanel>
                </ui:CardExpander>

            </StackPanel>
        </ScrollViewer>

        <!-- Нижняя панель действий -->
        <Border Grid.Row="2" Padding="16,12"
                Background="{DynamicResource ApplicationBackgroundBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ui:Button Grid.Row="0" Grid.Column="0" Margin="0,0,8,0" Content="Открыть"
                           ToolTip="Загрузить ранее созданную конфигурацию из папки"
                           Icon="{ui:SymbolIcon FolderArrowUp24}" Click="OnOpen" />
                <ui:TextBox Grid.Row="0" Grid.Column="1" x:Name="OutputPathBox"
                            PlaceholderText="Папка для docker-compose.yml и .env"
                            Text="{Binding OutputPath, UpdateSourceTrigger=PropertyChanged}" />
                <ui:Button Grid.Row="0" Grid.Column="2" Margin="8,0,0,0" Content="Обзор…"
                           Icon="{ui:SymbolIcon FolderOpen24}" Click="OnBrowse" />
                <ui:Button Grid.Row="0" Grid.Column="3" Margin="8,0,0,0" Appearance="Primary"
                           Content="Создать" Icon="{ui:SymbolIcon DocumentArrowRight24}" Click="OnGenerate" />

                <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4" x:Name="StatusText"
                           Margin="0,8,0,0" TextWrapping="Wrap" />
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
