<ui:FluentWindow x:Class="BarkCloud.Drive.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:tray="clr-namespace:Wpf.Ui.Tray.Controls;assembly=Wpf.Ui.Tray"
                 Title="BarkCloud Drive" Height="520" Width="420"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="BarkCloud Drive"/>

        <tray:NotifyIcon Grid.Row="0" x:Name="TrayIcon"
                         FocusOnLeftClick="True"
                         MenuOnRightClick="True"
                         TooltipText="BarkCloud Drive">
            <tray:NotifyIcon.Menu>
                <ContextMenu>
                    <MenuItem Header="Открыть" Click="ShowClick"/>
                    <Separator/>
                    <MenuItem Header="Примонтировать" Click="MountClick"/>
                    <MenuItem Header="Отмонтировать" Click="UnmountClick"/>
                    <Separator/>
                    <MenuItem Header="Закрыть приложение" Click="ExitClick"/>
                </ContextMenu>
            </tray:NotifyIcon.Menu>
        </tray:NotifyIcon>

        <StackPanel Grid.Row="1" Margin="16,8,16,16">
            <!-- Предупреждение: движок не запущен -->
            <Border x:Name="EngineWarning" Visibility="Collapsed"
                    Background="#33FF8C00" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Движок не запущен" FontWeight="Bold"/>
                    <TextBlock Text="Фоновый процесс BarkCloud Drive не обнаружен."
                               TextWrapping="Wrap" Margin="0,2,0,8"/>
                    <ui:Button Content="Запустить движок" Appearance="Primary" Click="StartEngineClick"/>
                </StackPanel>
            </Border>

            <!-- Профиль -->
            <ui:Card>
                <StackPanel>
                    <TextBlock x:Name="UsernameText" FontWeight="Bold" FontSize="16" Text="—"/>
                    <TextBlock x:Name="ServerText" Opacity="0.7" FontSize="12"/>
                </StackPanel>
            </ui:Card>

            <!-- Хранилище -->
            <ui:Card Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="Хранилище" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <ProgressBar x:Name="UsageBar" Minimum="0" Maximum="100" Height="6"/>
                    <TextBlock x:Name="UsageText" Margin="0,8,0,0" Text="—"/>
                    <TextBlock x:Name="DriveStateText" Opacity="0.7" Margin="0,2,0,0" Text="—"/>
                </StackPanel>
            </ui:Card>

            <ui:Button x:Name="SettingsButton" Content="Настройки" HorizontalAlignment="Right"
                       Margin="0,16,0,0" Click="OpenSettingsClick"/>

            <TextBlock x:Name="StatusText" TextWrapping="Wrap" Opacity="0.7" Margin="0,12,0,0"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
