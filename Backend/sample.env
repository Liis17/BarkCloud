# Сгенерировано BarkCloud.Builder

# Публичный адрес Configuration-сервиса для остальных сервисов
CONFIGURATION_SERVICE_URL=http://cloud-configuration:8003

CONFIGURATION_ACCESS_KEY=replace-with-strong-access-key

# Docker-сеть и имена контейнеров
DOCKER_NETWORK_NAME=barkcloud-network
CONFIGURATION_CONTAINER_NAME=cloud-configuration
IDENTITY_CONTAINER_NAME=cloud-identity
USERS_CONTAINER_NAME=cloud-users
FILES_CONTAINER_NAME=cloud-files
NOTIFICATION_CONTAINER_NAME=cloud-notification
TORRENT_CONTAINER_NAME=cloud-torrent
WEB_CONTAINER_NAME=cloud-web
MINIO_CONTAINER_NAME=cloud-minio
RABBITMQ_CONTAINER_NAME=cloud-rabbitmq
POSTGRES_CONTAINER_NAME=cloud-postgres

# Режим ASP.NET Core
ASPNETCORE_ENVIRONMENT=Production

# MinIO
MINIO_ROOT_USER=replace-with-minio-user
MINIO_ROOT_PASSWORD=replace-with-minio-password
MINIO_PORT=9000
MINIO_WEBPORT=9001
MINIO_DATA_PATH=./data/minio

# RabbitMQ
RABBITMQ_DEFAULT_USER=replace-with-rabbit-user
RABBITMQ_DEFAULT_PASS=replace-with-rabbit-password

# Postgres
POSTGRES_USER=replace-with-postgres-user
POSTGRES_PASSWORD=replace-with-postgres-password
POSTGRES_DB=postgrescloud
POSTGRES_PORT=5432
POSTGRES_DATA_PATH=./data/pgdata
BACKUP_PATH=./data/pgbackup

# Порты сервисов
IDENTITY_PORT=8000
USERS_PORT=8001
CONFIGURATION_PORT=8003
FILES_PORT=8005
FILES_HTTP1PORT=8006
TORRENT_PORT=8007
TORRENT_HTTP1PORT=8008
TORRENT_PEER_PORT=6881

# Torrent — папка на хосте для скачанных торрентов (пусто — named volume torrent_data)
TORRENT_DOWNLOAD_PATH=./data/torrent

# Files — внешняя папка для временных ZIP-архивов (пусто — named volume archive_temp)
ARCHIVE_TEMP_PATH=./data/archive-temp

# Независимые каналы логирования сервисов
CONFIGURATION_CONSOLE_OUTPUT=true
CONFIGURATION_SEQ_ENABLE=false
CONFIGURATION_LOGNARA_ENABLE=false
IDENTITY_CONSOLE_OUTPUT=true
IDENTITY_SEQ_ENABLE=false
IDENTITY_LOGNARA_ENABLE=false
USERS_CONSOLE_OUTPUT=true
USERS_SEQ_ENABLE=false
USERS_LOGNARA_ENABLE=false
FILES_CONSOLE_OUTPUT=true
FILES_SEQ_ENABLE=false
FILES_LOGNARA_ENABLE=false
NOTIFICATION_CONSOLE_OUTPUT=true
NOTIFICATION_SEQ_ENABLE=false
NOTIFICATION_LOGNARA_ENABLE=false
TORRENT_CONSOLE_OUTPUT=true
TORRENT_SEQ_ENABLE=false
TORRENT_LOGNARA_ENABLE=false
WEB_CONSOLE_OUTPUT=true
WEB_SEQ_ENABLE=false
WEB_LOGNARA_ENABLE=false

# Веб-клиент
WEB_PORT=8080
WEB_COOKIE_SECURE=false
WEB_PUBLIC_HOST=https://cloud.barkfluff.com
WEB_ADMIN_PASSWORD=replace-with-web-admin-password

# Внешние адреса сервисов для клиентов (обязательны)
EXTERNAL_IDENTITY_HOST=https://cloud.barkfluff.com:8000
EXTERNAL_USERS_HOST=https://cloud.barkfluff.com:8001
EXTERNAL_FILES_HOST=https://cloud.barkfluff.com:8005
EXTERNAL_TORRENT_HOST=https://cloud.barkfluff.com:8007

# SHA-256 fingerprint of the Android APK signing certificate (empty disables Android passkeys)
BARKCLOUD_ANDROID_CERT_SHA256_FINGERPRINT=

# Почта SMTP (опционально; заполните все 4 поля, чтобы включить подтверждение по email)
EMAIL_HOST=
EMAIL_PORT=
EMAIL_SENDER_EMAIL=
EMAIL_SENDER_PASSWORD=

# Пример включения Lognara через BarkCloud.Builder; значения ниже — заглушки, не секреты.
# Включите Lognara и заполните Core URL, relay token и отдельные agent tokens из Dock.
# Builder добавит local relay в barkcloud-network и agent wiring только выбранным контейнерам.
# Core URL relay принимает HTTP или HTTPS; agents отправляют ему по внутреннему HTTP.
# Lognara Core:
# LOGNARA_CORE_URL=https://lognara.example.invalid/v1/batches
# LOGNARA_RELAY_CORE_TOKEN=replace-with-relay-core-token
# LOGNARA_RELAY_MEMORY_MB=2048
# LOGNARA_AGENT_VERSION=latest
# Общие agent metadata:
# LOGNARA_SERVER=replace-with-server-name
# LOGNARA_BACKEND=barkcloud
# LOGNARA_ENVIRONMENT=Production
# Токены должны быть разными у каждого агента и выдаваться вручную в Dock:
# LOGNARA_CONFIGURATION_TOKEN=replace-configuration-agent-token
# LOGNARA_IDENTITY_TOKEN=replace-identity-agent-token
# LOGNARA_USERS_TOKEN=replace-users-agent-token
# LOGNARA_FILES_TOKEN=replace-files-agent-token
# LOGNARA_NOTIFICATION_TOKEN=replace-notification-agent-token
# LOGNARA_TORRENT_TOKEN=replace-torrent-agent-token
# LOGNARA_WEB_TOKEN=replace-web-agent-token
# LOGNARA_MINIO_TOKEN=replace-minio-agent-token
# LOGNARA_POSTGRES_TOKEN=replace-postgres-agent-token
# LOGNARA_RABBITMQ_TOKEN=replace-rabbitmq-agent-token
# LOGNARA_NGINX_TOKEN=replace-nginx-agent-token
# LOGNARA_SEQ_TOKEN=replace-seq-agent-token
# Spool path можно оставить пустым для отдельного named volume каждого агента.
# При включённых nginx/Seq дополнительно задайте LOGNARA_NGINX_TOKEN/LOGNARA_SEQ_TOKEN.
# Configuration и Web получают весь .env через env_file; изоляция agent tokens не обеспечивается.
