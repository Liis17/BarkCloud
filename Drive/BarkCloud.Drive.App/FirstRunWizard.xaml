<ui:FluentWindow x:Class="BarkCloud.Drive.App.FirstRunWizard"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:loc="clr-namespace:BarkCloud.Drive.App.Localization"
                 Title="{loc:Tr Wizard_Title}" Height="460" Width="440"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 ResizeMode="NoResize"
                 WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{loc:Tr Wizard_Title}" ShowMaximize="False" ShowMinimize="False"/>

        <Grid Grid.Row="1" Margin="24,8,24,8">
            <!-- Шаг 1: адрес сервера -->
            <StackPanel x:Name="StepServer">
                <TextBlock Text="{loc:Tr Wizard_Step1}" FontWeight="Bold" FontSize="15" Margin="0,0,0,12"/>
                <TextBlock Text="{loc:Tr Wizard_ServerPrompt}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <TextBlock Text="{loc:Tr Common_ServerHost}" Margin="0,0,0,4"/>
                <ui:TextBox x:Name="HostBox" PlaceholderText="cloud.example.com" Margin="0,0,0,12"/>
                <TextBlock Text="{loc:Tr Common_Ports}" Margin="0,0,0,4"/>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,4,0">
                        <TextBlock Text="Identity" Opacity="0.7" Margin="0,0,0,2"/>
                        <ui:TextBox x:Name="IdentityPortBox"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="4,0,4,0">
                        <TextBlock Text="Files" Opacity="0.7" Margin="0,0,0,2"/>
                        <ui:TextBox x:Name="FilesPortBox"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="4,0,0,0">
                        <TextBlock Text="Users" Opacity="0.7" Margin="0,0,0,2"/>
                        <ui:TextBox x:Name="UsersPortBox"/>
                    </StackPanel>
                </Grid>
                <CheckBox x:Name="AcceptCertCheck" Content="{loc:Tr Common_AcceptCert}" IsChecked="True"/>
            </StackPanel>

            <!-- Шаг 2: вход -->
            <StackPanel x:Name="StepLogin" Visibility="Collapsed">
                <TextBlock Text="{loc:Tr Wizard_Step2}" FontWeight="Bold" FontSize="15" Margin="0,0,0,12"/>
                <StackPanel x:Name="LoginFields">
                    <ui:TextBox x:Name="UsernameBox" PlaceholderText="{loc:Tr Wizard_LoginPlaceholder}" Margin="0,2,0,8"/>
                    <ui:PasswordBox x:Name="PasswordBox" PlaceholderText="{loc:Tr Wizard_PasswordPlaceholder}" Margin="0,2,0,8"/>
                    <ui:TextBox x:Name="OtpBox" PlaceholderText="{loc:Tr Wizard_OtpPlaceholder}" Margin="0,2,0,8"/>
                </StackPanel>
                <TextBlock x:Name="AlreadyLoggedIn" Visibility="Collapsed" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- Шаг 3: имя и буква -->
            <StackPanel x:Name="StepDrive" Visibility="Collapsed">
                <TextBlock Text="{loc:Tr Wizard_Step3}" FontWeight="Bold" FontSize="15" Margin="0,0,0,12"/>
                <TextBlock Text="{loc:Tr Common_DriveName}" Margin="0,0,0,4"/>
                <ui:TextBox x:Name="VolumeLabelBox" Text="BarkCloud" Margin="0,0,0,12"/>
                <TextBlock Text="{loc:Tr Common_DriveLetter}" Margin="0,0,0,4"/>
                <ComboBox x:Name="LetterCombo" HorizontalAlignment="Stretch"/>
            </StackPanel>

            <!-- Шаг 4: папка кэша -->
            <StackPanel x:Name="StepCache" Visibility="Collapsed">
                <TextBlock Text="{loc:Tr Wizard_Step4}" FontWeight="Bold" FontSize="15" Margin="0,0,0,12"/>
                <TextBlock Text="{loc:Tr Wizard_CachePrompt}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ui:TextBox x:Name="CacheDirBox" Grid.Column="0" IsReadOnly="True" Margin="0,0,8,0"/>
                    <ui:Button x:Name="BrowseButton" Grid.Column="1" Content="{loc:Tr Common_Browse}" Click="BrowseClick"/>
                </Grid>
            </StackPanel>

            <!-- Шаг 5: автозагрузка -->
            <StackPanel x:Name="StepAutostart" Visibility="Collapsed">
                <TextBlock Text="{loc:Tr Wizard_Step5}" FontWeight="Bold" FontSize="15" Margin="0,0,0,12"/>
                <TextBlock Text="{loc:Tr Wizard_AutostartPrompt}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                <CheckBox x:Name="AutostartAppCheck" Content="{loc:Tr Common_AutostartApp}" IsChecked="True" Margin="0,0,0,8"/>
                <CheckBox x:Name="AutostartEngineCheck" Content="{loc:Tr Common_AutostartEngine}" IsChecked="True"/>
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="2" x:Name="WizardStatus" Foreground="#E81123" TextWrapping="Wrap"
                   Margin="24,0,24,0" Visibility="Collapsed"/>

        <Grid Grid.Row="3" Margin="24,12,24,16">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                <TextBlock Text="{loc:Tr Common_Language}" VerticalAlignment="Center" Opacity="0.7" Margin="0,0,8,0"/>
                <ComboBox x:Name="LanguageCombo" Width="120" SelectionChanged="LanguageChanged"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button x:Name="BackButton" Content="{loc:Tr Common_Back}" Click="BackClick" Margin="0,0,8,0"/>
                <ui:Button x:Name="NextButton" Content="{loc:Tr Common_Next}" Appearance="Primary" Click="NextClick" Margin="0,0,8,0"/>
                <ui:Button Content="{loc:Tr Common_Cancel}" Click="CancelClick"/>
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
