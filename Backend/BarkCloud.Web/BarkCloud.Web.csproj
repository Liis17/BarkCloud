<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.32.0" />
    <PackageReference Include="Grpc.Net.ClientFactory" Version="2.71.0" />
    <PackageReference Include="Grpc.Tools" Version="2.72.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.14.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- LoadConfiguration(ServiceId.Web) тянет JwtSettings и адреса сервисов из Configuration-сервиса -->
    <ProjectReference Include="..\BarkCloud.GrpcServer\BarkCloud.GrpcServer.csproj" />
    <ProjectReference Include="..\..\Shared\BarkCloud.Shared.Auth\BarkCloud.Shared.Auth.csproj" />
    <ProjectReference Include="..\..\Shared\BarkCloud.Shared.Identity\BarkCloud.Shared.Identity.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="..\..\Shared\BarkCloud.Proto\shared.proto" GrpcServices="None" />
    <Protobuf Include="..\..\Shared\BarkCloud.Proto\identity_api.proto" GrpcServices="Client" />
    <Protobuf Include="..\..\Shared\BarkCloud.Proto\users_api.proto" GrpcServices="Client" />
    <Protobuf Include="..\..\Shared\BarkCloud.Proto\files_api.proto" GrpcServices="Client" />
  </ItemGroup>

  <!-- HTML/CSS/JSX страницы отдаются клиенту в рантайме — копируем их в output и publish -->
  <ItemGroup>
    <Content Include="Pages\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

</Project>
