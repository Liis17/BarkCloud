<ui:FluentWindow x:Class="BarkCloud.Builder.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:local="clr-namespace:BarkCloud.Builder"
                 mc:Ignorable="d"
                 Title="BarkCloud Builder"
                 Width="780" Height="880"
                 MinWidth="620" MinHeight="520"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowStartupLocation="CenterScreen">

    <ui:FluentWindow.Resources>
        <local:InverseBoolConverter x:Key="InverseBool" />
        <local:AnyEmptyToBoolConverter x:Key="AnyEmpty" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,10,0,2" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="BarkCloud Builder — генератор docker-compose">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="Box24" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16,8,16,8">
            <StackPanel>

                <!-- Сервисы -->
                <ui:Card Margin="0,0,0,8" Padding="16">
                    <StackPanel>
                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="Сервисы в compose" />
                        <TextBlock Margin="0,2,0,10"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Text="Ядро (configuration, identity, users, files) и web включаются всегда. Остальное — по выбору." />
                        <UniformGrid Columns="2">
                            <ui:ToggleSwitch x:Name="NginxToggle" Margin="0,4" Content="nginx (reverse-proxy)" IsChecked="{Binding IncludeNginx}" />
                            <ui:ToggleSwitch Margin="0,4" Content="notification (SMTP)" IsChecked="{Binding IncludeNotification}" />
                            <ui:ToggleSwitch x:Name="MinioToggle" Margin="0,4" Content="minio (хранилище)" IsChecked="{Binding IncludeMinio}" />
                            <ui:ToggleSwitch x:Name="RabbitToggle" Margin="0,4" Content="rabbitmq (очередь)" IsChecked="{Binding IncludeRabbitmq}" />
                            <ui:ToggleSwitch x:Name="PostgresToggle" Margin="0,4" Content="postgres (БД)" IsChecked="{Binding IncludePostgres}" />
                            <ui:ToggleSwitch x:Name="SeqToggle" Margin="0,4" Content="seq (логи)" IsChecked="{Binding IncludeSeq}" />
                        </UniformGrid>

                        <ui:InfoBar Margin="0,10,0,0" Severity="Warning" IsClosable="False"
                                    IsOpen="{Binding IsChecked, ElementName=MinioToggle, Converter={StaticResource InverseBool}}"
                                    Title="MinIO отключён"
                                    Message="Хранилище нужно поднять отдельно и вручную прописать его параметры в базе Configuration." />
                        <ui:InfoBar Margin="0,8,0,0" Severity="Warning" IsClosable="False"
                                    IsOpen="{Binding IsChecked, ElementName=RabbitToggle, Converter={StaticResource InverseBool}}"
                                    Title="RabbitMQ отключён"
                                    Message="Брокер нужно поднять отдельно и вручную прописать его параметры в базе Configuration." />
                        <ui:InfoBar Margin="0,8,0,0" Severity="Warning" IsClosable="False"
                                    IsOpen="{Binding IsChecked, ElementName=PostgresToggle, Converter={StaticResource InverseBool}}"
                                    Title="PostgreSQL отключён"
                                    Message="Базу нужно поднять отдельно и вручную прописать подключение в базе Configuration." />
                        <ui:InfoBar Margin="0,8,0,0" Severity="Warning" IsClosable="False"
                                    IsOpen="{Binding IsChecked, ElementName=SeqToggle, Converter={StaticResource InverseBool}}"
                                    Title="Seq отключён"
                                    Message="Агрегатор логов нужно поднять отдельно и вручную прописать его в базе Configuration." />
                    </StackPanel>
                </ui:Card>

                <!-- Общие -->
                <ui:CardExpander Margin="0,0,0,8" Icon="{ui:SymbolIcon Settings24}" IsExpanded="True">
                    <ui:CardExpander.Header>
                        <StackPanel>
                            <TextBlock FontWeight="Medium" Text="Общие" />
                            <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="Окружение и bootstrap-ключ" />
                        </StackPanel>
                    </ui:CardExpander.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="ASPNETCORE_ENVIRONMENT" />
                        <ComboBox SelectedValue="{Binding AspNetCoreEnvironment, Mode=TwoWay}" SelectedValuePath="Content">
                            <ComboBoxItem Content="Production" />
                            <ComboBoxItem Content="Development" />
                        </ComboBox>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="CONFIGURATION_SERVICE_URL (имя контейнера + порт)" />
                        <ui:TextBox IsReadOnly="True"
                                    Text="{Binding Text, ElementName=ConfigPortBox, Mode=OneWay, StringFormat='http://cloud-configuration:{0}'}" />

                        <TextBlock Style="{StaticResource FieldLabel}" Text="CONFIGURATION_ACCESS_KEY (одинаковый у всех сервисов)" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox x:Name="AccessKeyBox" Grid.Column="0"
                                        Text="{Binding ConfigurationAccessKey, UpdateSourceTrigger=PropertyChanged}" />
                            <ui:Button Grid.Column="1" Margin="8,0,0,0" Content="Случайный"
                                       Icon="{ui:SymbolIcon ArrowSync24}" Tag="50"
                                       CommandParameter="{Binding ElementName=AccessKeyBox}" Click="OnRandom" />
                        </Grid>
                    </StackPanel>
                </ui:CardExpander>

                <!-- Образы -->
                <ui:CardExpander Margin="0,0,0,8" Icon="{ui:SymbolIcon Box24}">
                    <ui:CardExpander.Header>
                        <StackPanel>
                            <TextBlock FontWeight="Medium" Text="Образы" />
                            <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="Реестр и канал docker-образов" />
                        </StackPanel>
                    </ui:CardExpander.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Реестр" />
                        <ui:TextBox IsReadOnly="True" Text="docker.barkfluff.com:5000" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Канал" />
                        <ComboBox SelectedValue="{Binding ImageChannel, Mode=TwoWay}" SelectedValuePath="Tag">
                            <ComboBoxItem Content="Релиз — barkcloud-*:latest" Tag="Release" />
                            <ComboBoxItem Content="Дев — barkcloud-*-dev:latest" Tag="Dev" />
                        </ComboBox>
                    </StackPanel>
                </ui:CardExpander>

                <!-- MinIO -->
                <ui:CardExpander Margin="0,0,0,8" Icon="{ui:SymbolIcon Storage24}">
                    <ui:CardExpander.Header>
                        <StackPanel>
                            <TextBlock FontWeight="Medium" Text="MinIO" />
                            <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="S3-совместимое хранилище файлов" />
                        </StackPanel>
                    </ui:CardExpander.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="MINIO_ROOT_USER" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox x:Name="MinioUserBox" Grid.Column="0" Text="{Binding MinioRootUser, UpdateSourceTrigger=PropertyChanged}" />
                            <ui:Button Grid.Column="1" Margin="8,0,0,0" Content="Случайно" Icon="{ui:SymbolIcon ArrowSync24}"
                                       Tag="12" CommandParameter="{Binding ElementName=MinioUserBox}" Click="OnRandom" />
                        </Grid>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="MINIO_ROOT_PASSWORD" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox x:Name="MinioPassBox" Grid.Column="0" Text="{Binding MinioRootPassword, UpdateSourceTrigger=PropertyChanged}" />
                            <ui:Button Grid.Column="1" Margin="8,0,0,0" Content="Случайно" Icon="{ui:SymbolIcon ArrowSync24}"
                                       Tag="20" CommandParameter="{Binding ElementName=MinioPassBox}" Click="OnRandom" />
                        </Grid>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="MINIO_PORT (API)" />
                        <ui:TextBox Margin="0,0,0,6" Text="{Binding MinioPort, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="MINIO_WEBPORT (консоль)" />
                        <ui:TextBox Margin="0,0,0,6" Text="{Binding MinioWebPort, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="MINIO_DATA_PATH (пусто — named volume)" />
                        <ui:TextBox PlaceholderText="/d/barkcloud/minio" Text="{Binding MinioDataPath, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </ui:CardExpander>

                <!-- RabbitMQ -->
                <ui:CardExpander Margin="0,0,0,8" Icon="{ui:SymbolIcon Mail24}">
                    <ui:CardExpander.Header>
                        <StackPanel>
                            <TextBlock FontWeight="Medium" Text="RabbitMQ" />
                            <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="Брокер сообщений" />
                        </StackPanel>
                    </ui:CardExpander.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="RABBITMQ_DEFAULT_USER" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox x:Name="RabbitUserBox" Grid.Column="0" Text="{Binding RabbitUser, UpdateSourceTrigger=PropertyChanged}" />
                            <ui:Button Grid.Column="1" Margin="8,0,0,0" Content="Случайно" Icon="{ui:SymbolIcon ArrowSync24}"
                                       Tag="12" CommandParameter="{Binding ElementName=RabbitUserBox}" Click="OnRandom" />
                        </Grid>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="RABBITMQ_DEFAULT_PASS" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox x:Name="RabbitPassBox" Grid.Column="0" Text="{Binding RabbitPass, UpdateSourceTrigger=PropertyChanged}" />
                            <ui:Button Grid.Column="1" Margin="8,0,0,0" Content="Случайно" Icon="{ui:SymbolIcon ArrowSync24}"
                                       Tag="20" CommandParameter="{Binding ElementName=RabbitPassBox}" Click="OnRandom" />
                        </Grid>
                    </StackPanel>
                </ui:CardExpander>

                <!-- PostgreSQL -->
                <ui:CardExpander Margin="0,0,0,8" Icon="{ui:SymbolIcon Database24}">
                    <ui:CardExpander.Header>
                        <StackPanel>
                            <TextBlock FontWeight="Medium" Text="PostgreSQL" />
                            <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="База данных + подключение Configuration" />
                        </StackPanel>
                    </ui:CardExpander.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="POSTGRES_USER" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox x:Name="PostgresUserBox" Grid.Column="0" Text="{Binding PostgresUser, UpdateSourceTrigger=PropertyChanged}" />
                            <ui:Button Grid.Column="1" Margin="8,0,0,0" Content="Случайно" Icon="{ui:SymbolIcon ArrowSync24}"
                                       Tag="12" CommandParameter="{Binding ElementName=PostgresUserBox}" Click="OnRandom" />
                        </Grid>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="POSTGRES_PASSWORD" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox x:Name="PostgresPassBox" Grid.Column="0" Text="{Binding PostgresPassword, UpdateSourceTrigger=PropertyChanged}" />
                            <ui:Button Grid.Column="1" Margin="8,0,0,0" Content="Случайно" Icon="{ui:SymbolIcon ArrowSync24}"
                                       Tag="20" CommandParameter="{Binding ElementName=PostgresPassBox}" Click="OnRandom" />
                        </Grid>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="POSTGRES_DB" />
                        <ui:TextBox Margin="0,0,0,6" Text="{Binding PostgresDb, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="POSTGRES_PORT (host-маппинг)" />
                        <ui:TextBox Margin="0,0,0,6" Text="{Binding PostgresPort, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="POSTGRES_DATA_PATH (пусто — named volume)" />
                        <ui:TextBox Margin="0,0,0,6" PlaceholderText="/d/barkcloud/pgdata" Text="{Binding PostgresDataPath, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="BACKUP_PATH (пусто — named volume)" />
                        <ui:TextBox PlaceholderText="/d/barkcloud/backup" Text="{Binding BackupPath, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </ui:CardExpander>

                <!-- Порты сервисов -->
                <ui:CardExpander Margin="0,0,0,8" Icon="{ui:SymbolIcon Server24}">
                    <ui:CardExpander.Header>
                        <StackPanel>
                            <TextBlock FontWeight="Medium" Text="Порты сервисов" />
                            <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="Внешние порты (через nginx)" />
                        </StackPanel>
                    </ui:CardExpander.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="IDENTITY_PORT" />
                        <ui:TextBox Margin="0,0,0,6" Text="{Binding IdentityPort, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="USERS_PORT" />
                        <ui:TextBox Margin="0,0,0,6" Text="{Binding UsersPort, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="CONFIGURATION_PORT (порт запуска; доступен только в docker-сети)" />
                        <ui:TextBox x:Name="ConfigPortBox" Margin="0,0,0,6" Text="{Binding ConfigurationPort, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="FILES_PORT" />
                        <ui:TextBox Margin="0,0,0,6" Text="{Binding FilesPort, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="FILES_HTTP1PORT" />
                        <ui:TextBox Text="{Binding FilesHttp1Port, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </ui:CardExpander>

                <!-- Seq -->
                <ui:CardExpander Margin="0,0,0,8" Icon="{ui:SymbolIcon DocumentBulletList24}">
                    <ui:CardExpander.Header>
                        <StackPanel>
                            <TextBlock FontWeight="Medium" Text="Seq" />
                            <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="Агрегатор логов" />
                        </StackPanel>
                    </ui:CardExpander.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="SEQ_ADMIN_PASSWORD" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox x:Name="SeqPassBox" Grid.Column="0" Text="{Binding SeqAdminPassword, UpdateSourceTrigger=PropertyChanged}" />
                            <ui:Button Grid.Column="1" Margin="8,0,0,0" Content="Случайно" Icon="{ui:SymbolIcon ArrowSync24}"
                                       Tag="20" CommandParameter="{Binding ElementName=SeqPassBox}" Click="OnRandom" />
                        </Grid>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="SEQ_WEBPORT" />
                        <ui:TextBox Margin="0,0,0,6" Text="{Binding SeqWebPort, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="SEQ_DATA_PATH (пусто — named volume)" />
                        <ui:TextBox PlaceholderText="/d/barkcloud/seq" Text="{Binding SeqDataPath, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </ui:CardExpander>

                <!-- Веб-клиент -->
                <ui:CardExpander Margin="0,0,0,8" Icon="{ui:SymbolIcon Globe24}">
                    <ui:CardExpander.Header>
                        <StackPanel>
                            <TextBlock FontWeight="Medium" Text="Веб-клиент" />
                            <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="BarkCloud.Web" />
                        </StackPanel>
                    </ui:CardExpander.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="WEB_PORT" />
                        <ui:TextBox Margin="0,0,0,6" Text="{Binding WebPort, UpdateSourceTrigger=PropertyChanged}" />
                        <ui:ToggleSwitch x:Name="CookieSecureToggle" Margin="0,8,0,0" Content="WEB_COOKIE_SECURE" IsChecked="{Binding WebCookieSecure}" />
                        <ui:InfoBar Margin="0,8,0,0" Severity="Warning" IsClosable="False"
                                    IsOpen="{Binding IsChecked, ElementName=CookieSecureToggle}"
                                    Title="WEB_COOKIE_SECURE = true"
                                    Message="Включайте только при работе без nginx (не тестировалось)." />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="WEB_PUBLIC_HOST (пусто — из заголовка запроса)" />
                        <ui:TextBox Margin="0,0,0,6" Text="{Binding WebPublicHost, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="WEB_ADMIN_PASSWORD (пусто — раздел «Обслуживание» недоступен)" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox x:Name="WebAdminBox" Grid.Column="0" Text="{Binding WebAdminPassword, UpdateSourceTrigger=PropertyChanged}" />
                            <ui:Button Grid.Column="1" Margin="8,0,0,0" Content="Случайно" Icon="{ui:SymbolIcon ArrowSync24}"
                                       Tag="20" CommandParameter="{Binding ElementName=WebAdminBox}" Click="OnRandom" />
                        </Grid>
                    </StackPanel>
                </ui:CardExpander>

                <!-- Внешние адреса сервисов -->
                <ui:CardExpander Margin="0,0,0,8" Icon="{ui:SymbolIcon Link24}" IsExpanded="True">
                    <ui:CardExpander.Header>
                        <StackPanel>
                            <TextBlock FontWeight="Medium" Text="Внешние адреса сервисов" />
                            <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="Публичные адреса для клиентов (записываются в БД Configuration на чистом старте)" />
                        </StackPanel>
                    </ui:CardExpander.Header>
                    <StackPanel>
                        <ui:InfoBar Margin="0,0,0,4" Severity="Informational" IsClosable="False" IsOpen="True"
                                    Title="Обязательны"
                                    Message="По умолчанию — домен + порт сервиса (как маршрутизирует nginx). Если оставить пусто, Configuration вне Development упадёт при старте." />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="EXTERNAL_IDENTITY_HOST" />
                        <ui:TextBox Margin="0,0,0,6" Text="{Binding ExternalIdentityHost, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="EXTERNAL_USERS_HOST" />
                        <ui:TextBox Margin="0,0,0,6" Text="{Binding ExternalUsersHost, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="EXTERNAL_FILES_HOST" />
                        <ui:TextBox Text="{Binding ExternalFilesHost, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </ui:CardExpander>

                <!-- Почта (SMTP) -->
                <ui:CardExpander Margin="0,0,0,8" Icon="{ui:SymbolIcon Mail24}">
                    <ui:CardExpander.Header>
                        <StackPanel>
                            <TextBlock FontWeight="Medium" Text="Почта (SMTP)" />
                            <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="Подтверждение по email — опционально" />
                        </StackPanel>
                    </ui:CardExpander.Header>
                    <StackPanel>
                        <ui:InfoBar Margin="0,0,0,4" Severity="Informational" IsClosable="False" IsOpen="True"
                                    Title="Опционально"
                                    Message="Заполните все 4 поля, чтобы включить подтверждение по email. Если оставить пусто — работа без почты." />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="EMAIL_HOST" />
                        <ui:TextBox Margin="0,0,0,6" PlaceholderText="smtp.example.com"
                                    Text="{Binding EmailHost, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="EMAIL_PORT" />
                        <ui:TextBox Margin="0,0,0,6" PlaceholderText="587"
                                    Text="{Binding EmailPort, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="EMAIL_SENDER_EMAIL" />
                        <ui:TextBox Margin="0,0,0,6" PlaceholderText="noreply@example.com"
                                    Text="{Binding EmailSenderEmail, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="EMAIL_SENDER_PASSWORD" />
                        <ui:TextBox Text="{Binding EmailSenderPassword, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </ui:CardExpander>

                <!-- Nginx / HTTPS -->
                <ui:CardExpander Margin="0,0,0,8" Icon="{ui:SymbolIcon ShieldLock24}"
                                 Visibility="{Binding IsChecked, ElementName=NginxToggle, Converter={StaticResource BoolToVis}}">
                    <ui:CardExpander.Header>
                        <StackPanel>
                            <TextBlock FontWeight="Medium" Text="Nginx / HTTPS" />
                            <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="Домен и TLS-сертификаты (порты берутся из «Порты сервисов»)" />
                        </StackPanel>
                    </ui:CardExpander.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Внешний домен (server_name)" />
                        <ui:TextBox Text="{Binding NginxDomain, UpdateSourceTrigger=PropertyChanged}" />
                        <ui:InfoBar Margin="0,8,0,0" Severity="Informational" IsClosable="False" IsOpen="True"
                                    Title="Домен панели"
                                    Message="Рекомендуется, чтобы домен совпадал с хостом из WEB_PUBLIC_HOST." />

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Сертификат — crt (barkfluff.com-crt.pem)" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox x:Name="CertCrtBox" Grid.Column="0" IsReadOnly="True"
                                        PlaceholderText="не выбран"
                                        Text="{Binding CertCrtPath, UpdateSourceTrigger=PropertyChanged}" />
                            <ui:Button Grid.Column="1" Margin="8,0,0,0" Content="Выбрать…" Icon="{ui:SymbolIcon FolderOpen24}"
                                       CommandParameter="{Binding ElementName=CertCrtBox}" Click="OnPickCert" />
                        </Grid>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Ключ — key (barkfluff.com-key.pem)" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox x:Name="CertKeyBox" Grid.Column="0" IsReadOnly="True"
                                        PlaceholderText="не выбран"
                                        Text="{Binding CertKeyPath, UpdateSourceTrigger=PropertyChanged}" />
                            <ui:Button Grid.Column="1" Margin="8,0,0,0" Content="Выбрать…" Icon="{ui:SymbolIcon FolderOpen24}"
                                       CommandParameter="{Binding ElementName=CertKeyBox}" Click="OnPickCert" />
                        </Grid>

                        <ui:InfoBar Margin="0,10,0,0" Severity="Warning" IsClosable="False"
                                    Title="Сертификаты не выбраны"
                                    Message="Нужны для HTTPS. Можно сгенерировать и без них (положить в certs/ позже), но это очень небезопасно.">
                            <ui:InfoBar.IsOpen>
                                <MultiBinding Converter="{StaticResource AnyEmpty}">
                                    <Binding Path="Text" ElementName="CertCrtBox" />
                                    <Binding Path="Text" ElementName="CertKeyBox" />
                                </MultiBinding>
                            </ui:InfoBar.IsOpen>
                        </ui:InfoBar>
                    </StackPanel>
                </ui:CardExpander>

            </StackPanel>
        </ScrollViewer>

        <!-- Нижняя панель действий -->
        <Border Grid.Row="2" Padding="16,12"
                Background="{DynamicResource ApplicationBackgroundBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ui:TextBox Grid.Row="0" Grid.Column="0" x:Name="OutputPathBox"
                            PlaceholderText="Папка для docker-compose.yml и .env"
                            Text="{Binding OutputPath, UpdateSourceTrigger=PropertyChanged}" />
                <ui:Button Grid.Row="0" Grid.Column="1" Margin="8,0,0,0" Content="Обзор…"
                           Icon="{ui:SymbolIcon FolderOpen24}" Click="OnBrowse" />
                <ui:Button Grid.Row="0" Grid.Column="2" Margin="8,0,0,0" Appearance="Primary"
                           Content="Сгенерировать" Icon="{ui:SymbolIcon DocumentArrowRight24}" Click="OnGenerate" />

                <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" x:Name="StatusText"
                           Margin="0,8,0,0" TextWrapping="Wrap" />
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
