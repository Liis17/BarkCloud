# Публичный адрес Configuration-сервиса для остальных сервисов
CONFIGURATION_SERVICE_URL=http://cloud-configuration:7003

CONFIGURATION_ACCESS_KEY=4ranR2hjA7MAt9TjJwQpIOWMkInJ8w3byKlJrF4vqubzwJCa2 # Bootstrap-ключ доступа к ConfigurationApi (раздаёт секреты всем сервисам при старте). Задайте длинную случайную строку. Если пусто — доступ открыт (только для миграции; небезопасно). Должен совпадать у всех сервисов (прокидывается через x-common-variables в docker-compose).

# Режим ASP.NET Core
ASPNETCORE_ENVIRONMENT=Production

# MinIO
MINIO_ROOT_USER=user # имя пользователя для доступа к MinIO API и UI
MINIO_ROOT_PASSWORD=password # пароль для доступа к MinIO API и UI
MINIO_PORT=9020 # порт для доступа к MinIO API (S3-совместимому)
MINIO_WEBPORT=9021 # веб порт для доступа к UI MinIO
MINIO_DATA_PATH= /d/barkcloud/minio # Папка на диске для данных MinIO (интегритет не критичен). Пусто — named volume minio_data (в образе WSL).

# RabbitMQ
RABBITMQ_DEFAULT_USER=user
RABBITMQ_DEFAULT_PASS=password

# Postgres
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=postgres
POSTGRES_PORT=6543 # внешний порт для доступа к Postgres (внутри контейнера обычно 5432)
POSTGRES_DATA_PATH=
BACKUP_PATH=

# Параметры подключения Configuration к Postgres
CONFIGURATION_HOST=postgres:6543
CONFIGURATION_DATABASE=configuration
CONFIGURATION_USERNAME=user
CONFIGURATION_PASSWORD=password
CONFIGURATION_PORT=7023

# Порты сервисов
IDENTITY_PORT=7020
USERS_PORT=7021
FILES_PORT=7025
FILES_HTTP1PORT=7026

# Seq (агрегатор логов)
SEQ_ADMIN_PASSWORD=password
SEQ_WEBPORT=8881
# Куда Seq кладёт данные (/data). Пусто — named volume seq_data (в образе WSL).
# Опционально вынести логи папкой на диске (интегритет не критичен), напр. SEQ_DATA_PATH=/d/barkcloud/seq
SEQ_DATA_PATH=

# Веб-клиент (BarkCloud.Web). JwtSettings и адреса сервисов берутся из Configuration-сервиса.
WEB_PORT=63222
WEB_COOKIE_SECURE=false
# Публичный хост инстанса (для отображения в UI). Пусто — берётся из заголовка запроса.
WEB_PUBLIC_HOST=
# Пароль доступа к разделу «Обслуживание» (обновление/перезапуск бэкенда из настроек веба).
# Пусто — раздел недоступен. Задайте надёжный пароль на проде.
WEB_ADMIN_PASSWORD=
