# Публичный адрес Configuration-сервиса для остальных сервисов
CONFIGURATION_SERVICE_URL=http://cloud-configuration:7023

CONFIGURATION_ACCESS_KEY=w...u

# Режим ASP.NET Core
ASPNETCORE_ENVIRONMENT=Production

# MinIO
MINIO_ROOT_USER=...
MINIO_ROOT_PASSWORD=...
MINIO_PORT=9020
MINIO_WEBPORT=9021
MINIO_DATA_PATH=/data/minio

#files
ARCHIVE_TEMP_PATH=/mnt/temp

# RabbitMQ
RABBITMQ_DEFAULT_USER=...
RABBITMQ_DEFAULT_PASS=...

# Postgres
POSTGRES_USER=...
POSTGRES_PASSWORD=...
POSTGRES_DB=postgrescloud
POSTGRES_PORT=6543
POSTGRES_DATA_PATH=/data/pgdata
BACKUP_PATH=/data/pgbackup

# Порты сервисов
IDENTITY_PORT=7020
USERS_PORT=7021
CONFIGURATION_PORT=7023
FILES_PORT=7025
FILES_HTTP1PORT=7026
TORRENT_PORT=7027
TORRENT_HTTP1PORT=7028
TORRENT_PEER_PORT=6881

# Seq (агрегатор логов)
SEQ_ADMIN_PASSWORD=...
SEQ_WEBPORT=8881
SEQ_DATA_PATH=/data/seq

# Веб-клиент
WEB_PORT=63222
WEB_COOKIE_SECURE=false
WEB_PUBLIC_HOST=https://cloud.barkfluff.com
WEB_ADMIN_PASSWORD=...

# Внешние адреса сервисов для клиентов (обязательны)
EXTERNAL_IDENTITY_HOST=https://cloud.barkfluff.com:7020
EXTERNAL_USERS_HOST=https://cloud.barkfluff.com:7021
EXTERNAL_FILES_HOST=https://cloud.barkfluff.com:7025
EXTERNAL_TORRENT_HOST=https://cloud.barkfluff.com:7027

# Почта SMTP (опционально; заполните все 4 поля, чтобы включить подтверждение по email)
EMAIL_HOST=...
EMAIL_PORT=...
EMAIL_SENDER_EMAIL=...
EMAIL_SENDER_PASSWORD=...

# Torrent — папка на хосте для скачанных торрентов (пусто — named volume torrent_data)
TORRENT_DOWNLOAD_PATH=/data/torrent