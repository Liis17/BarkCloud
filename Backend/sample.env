# Публичный адрес Configuration-сервиса для остальных сервисов
CONFIGURATION_SERVICE_URL=http://cloud-configuration:7023 # URL для доступа к ConfigurationApi из других сервисов. Должен совпадать с именем сервиса в docker-compose (cloud-configuration) и портом, который он слушает (7003).

CONFIGURATION_ACCESS_KEY=4ranR2hjA7MAt9TjJwQpIOWMkInJ8w3byKlJrF4vqubzwJCa2 # Bootstrap-ключ доступа к ConfigurationApi (раздаёт секреты всем сервисам при старте). Задайте длинную случайную строку. Если пусто — доступ открыт (только для миграции; небезопасно). Должен совпадать у всех сервисов (прокидывается через x-common-variables в docker-compose).

# Режим ASP.NET Core
ASPNETCORE_ENVIRONMENT=Production # влияет на поведение некоторых сервисов 

# MinIO
MINIO_ROOT_USER=user # имя пользователя для доступа к MinIO API и UI
MINIO_ROOT_PASSWORD=password # пароль для доступа к MinIO API и UI
MINIO_PORT=9020 # порт для доступа к MinIO API (S3-совместимому)
MINIO_WEBPORT=9021 # веб порт для доступа к UI MinIO
MINIO_DATA_PATH= /d/barkcloud/minio # Папка на диске для данных MinIO (интегритет не критичен). Пусто — named volume minio_data (в образе WSL).

# RabbitMQ
RABBITMQ_DEFAULT_USER=user # имя пользователя для доступа к RabbitMQ (для сервисов и админки)
RABBITMQ_DEFAULT_PASS=password # пароль для доступа к RabbitMQ (для сервисов и админки)

# Postgres
POSTGRES_USER=user # имя пользователя для доступа к Postgres (для сервисов и админки)
POSTGRES_PASSWORD=password # пароль для доступа к Postgres (для сервисов и админки)
POSTGRES_DB=postgrescloud
POSTGRES_PORT=6543 # внешний порт для доступа к Postgres (внутри контейнера обычно 5432)
POSTGRES_DATA_PATH= /d/barkcloud/pgdata # Папка на диске для данных Postgres (интегритет не критичен). Пусто — named volume pgdata (в образе WSL). 
BACKUP_PATH= /d/barkcloud/backup # Папка на диске для бэкапов Postgres (интегритет не критичен). Пусто — named volume backup_volume (в образе WSL).

# Параметры подключения Configuration к Postgres
CONFIGURATION_USERNAME=user 
CONFIGURATION_PASSWORD=password


# Порты сервисов
IDENTITY_PORT=7020
USERS_PORT=7021
CONFIGURATION_PORT=7023
FILES_PORT=7025
FILES_HTTP1PORT=7026

# Seq (агрегатор логов)
SEQ_ADMIN_PASSWORD=password # Пароль для доступа к Seq UI. Задайте надёжный пароль на проде. Если пусто — доступ открыт (небезопасно).
SEQ_WEBPORT=8881 # Внешний порт для доступа к Seq UI 
SEQ_DATA_PATH= /d/barkcloud/seq # Папка на диске для данных Seq 

# Веб-клиент 
WEB_PORT=63222 # Внешний порт для доступа к веб-клиенту. Внутри контейнера всегда 8080.
WEB_COOKIE_SECURE=false # true только если работа без nginx (не тестировалось)
WEB_PUBLIC_HOST=https://cloud.barkfluff.com # Публичный адрес веб-клиента для генерации ссылок
WEB_ADMIN_PASSWORD=oigOspWY3ezl3inseEnQ # Пароль доступа к разделу «Обслуживание» (обновление бэкенда). Пусто → раздел недоступен
