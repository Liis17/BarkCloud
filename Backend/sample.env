# Публичный адрес Configuration-сервиса для остальных сервисов
CONFIGURATION_SERVICE_URL=http://cloud-configuration:8003

CONFIGURATION_ACCESS_KEY=w...u

# Режим ASP.NET Core
ASPNETCORE_ENVIRONMENT=Production

# MinIO
MINIO_ROOT_USER=...
MINIO_ROOT_PASSWORD=...
MINIO_PORT=9000
MINIO_WEBPORT=9001
MINIO_DATA_PATH=/data/minio

#files
ARCHIVE_TEMP_PATH=/data/archive-temp

# RabbitMQ
RABBITMQ_DEFAULT_USER=...
RABBITMQ_DEFAULT_PASS=...

# Postgres
POSTGRES_USER=...
POSTGRES_PASSWORD=...
POSTGRES_DB=postgrescloud
POSTGRES_PORT=5432
POSTGRES_DATA_PATH=/data/pgdata
BACKUP_PATH=/data/pgbackup

# Порты сервисов
IDENTITY_PORT=8000
USERS_PORT=8001
CONFIGURATION_PORT=8003
FILES_PORT=8005
FILES_HTTP1PORT=8006
TORRENT_PORT=8007
TORRENT_HTTP1PORT=8008
TORRENT_PEER_PORT=6881

# Seq (агрегатор логов)
SEQ_ADMIN_PASSWORD=...
SEQ_WEBPORT=80
SEQ_DATA_PATH=/data/seq

# Веб-клиент
WEB_PORT=8080
WEB_COOKIE_SECURE=false
WEB_PUBLIC_HOST=https://cloud.barkfluff.com
WEB_ADMIN_PASSWORD=...

# Внешние адреса сервисов для клиентов (обязательны)
EXTERNAL_IDENTITY_HOST=https://cloud.barkfluff.com:8000
EXTERNAL_USERS_HOST=https://cloud.barkfluff.com:8001
EXTERNAL_FILES_HOST=https://cloud.barkfluff.com:8005
EXTERNAL_TORRENT_HOST=https://cloud.barkfluff.com:8007

# Почта SMTP (опционально; заполните все 4 поля, чтобы включить подтверждение по email)
EMAIL_HOST=...
EMAIL_PORT=...
EMAIL_SENDER_EMAIL=...
EMAIL_SENDER_PASSWORD=...

# Torrent — папка на хосте для скачанных торрентов (пусто — named volume torrent_data)
TORRENT_DOWNLOAD_PATH=/data/torrent

# Lognara — опциональный сбор логов только Configuration; включите согласованные настройки в docker-compose.yml
# Внешнюю сеть нужно создать заранее и подключить к ней relay, слушающий 0.0.0.0:7401.
# Агент принимает только HTTP; используйте персональный токен агента из dock.
# .env целиком передаётся Configuration и Web через env_file.
# LOGNARA_NETWORK=lognara-ingest
# LOGNARA_RELAY_URL=http://lognara-relay:7401/v1/batches
# LOGNARA_CONFIGURATION_TOKEN=replace-with-personal-agent-token
# LOGNARA_SERVER=docker-host
# LOGNARA_BACKEND=barkcloud
# LOGNARA_ENVIRONMENT=Production
# Пустой путь использует named volume; bind-каталог должен быть доступен на запись UID/GID 1654.
# LOGNARA_CONFIGURATION_SPOOL_PATH=
