<ui:FluentWindow x:Class="BarkCloud.Drive.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:tray="clr-namespace:Wpf.Ui.Tray.Controls;assembly=Wpf.Ui.Tray"
                 Title="BarkCloud Drive" Height="600" Width="400"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="BarkCloud Drive"/>

        <tray:NotifyIcon Grid.Row="0" x:Name="TrayIcon"
                         FocusOnLeftClick="True"
                         MenuOnRightClick="True"
                         TooltipText="BarkCloud Drive">
            <tray:NotifyIcon.Menu>
                <ContextMenu>
                    <MenuItem Header="Открыть" Click="ShowClick"/>
                    <Separator/>
                    <MenuItem Header="Примонтировать" Click="MountClick"/>
                    <MenuItem Header="Отмонтировать" Click="UnmountClick"/>
                    <Separator/>
                    <MenuItem Header="Закрыть приложение" Click="ExitClick"/>
                </ContextMenu>
            </tray:NotifyIcon.Menu>
        </tray:NotifyIcon>

        <Grid Grid.Row="1" Margin="16,8,16,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Меню «три точки» -->
            <ui:Button Grid.Row="0" x:Name="MoreButton" HorizontalAlignment="Right"
                       Appearance="Transparent" Content="⋯" FontSize="18" FontWeight="Bold"
                       Padding="10,0" Click="MoreClick">
                <ui:Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Запустить движок" Click="StartEngineClick"/>
                        <MenuItem Header="Принудительно закрыть движок" Click="StopEngineClick"/>
                    </ContextMenu>
                </ui:Button.ContextMenu>
            </ui:Button>

            <StackPanel Grid.Row="1" Margin="0,4,0,0">
                <StackPanel x:Name="LoginPanel">
                    <TextBlock Text="Вход" FontWeight="Bold" FontSize="14" Margin="0,0,0,6"/>
                    <ui:TextBox x:Name="UsernameBox" PlaceholderText="Логин или email" Margin="0,2,0,8"/>
                    <ui:PasswordBox x:Name="PasswordBox" PlaceholderText="Пароль" Margin="0,2,0,8"/>
                    <ui:TextBox x:Name="OtpBox" PlaceholderText="OTP-код (если включён 2FA)" Margin="0,2,0,8"/>
                    <ui:Button x:Name="LoginButton" Content="Войти" Click="LoginClick"
                               Appearance="Primary" HorizontalAlignment="Stretch"/>

                    <Separator Margin="0,12"/>
                </StackPanel>

                <TextBlock Text="Монтирование" FontWeight="Bold" FontSize="14" Margin="0,0,0,6"/>
                <ComboBox x:Name="LetterCombo" Margin="0,2,0,8" HorizontalAlignment="Stretch"/>
                <StackPanel Orientation="Horizontal">
                    <ui:Button x:Name="MountButton" Content="Примонтировать" Click="MountClick" Width="160" Margin="0,0,8,0"/>
                    <ui:Button x:Name="UnmountButton" Content="Отмонтировать" Click="UnmountClick" Width="160"/>
                </StackPanel>

                <Separator Margin="0,12"/>

                <TextBlock Text="Папка кэша" FontWeight="Bold" FontSize="14" Margin="0,0,0,6"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ui:TextBox x:Name="CacheDirBox" Grid.Column="0" IsReadOnly="True" Margin="0,0,8,0"/>
                    <ui:Button x:Name="BrowseCacheButton" Grid.Column="1" Content="Обзор…" Click="BrowseCacheClick"/>
                </Grid>

                <Separator Margin="0,12"/>

                <ui:Card>
                    <TextBlock x:Name="StatusText" TextWrapping="Wrap" Text="Не подключено."/>
                </ui:Card>
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
