<Window x:Class="BarkCloud.Drive.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BarkCloud Drive" Height="480" Width="380"
        WindowStartupLocation="CenterScreen">
    <StackPanel Margin="16">
        <TextBlock Text="Вход" FontWeight="Bold" FontSize="14" Margin="0,0,0,6"/>
        <TextBlock Text="Логин или email"/>
        <TextBox x:Name="UsernameBox" Margin="0,2,0,8"/>
        <TextBlock Text="Пароль"/>
        <PasswordBox x:Name="PasswordBox" Margin="0,2,0,8"/>
        <TextBlock Text="OTP-код (если включён 2FA)"/>
        <TextBox x:Name="OtpBox" Margin="0,2,0,8"/>
        <Button x:Name="LoginButton" Content="Войти" Click="LoginClick" Height="30"/>

        <Separator Margin="0,12"/>

        <TextBlock Text="Монтирование" FontWeight="Bold" FontSize="14" Margin="0,0,0,6"/>
        <TextBlock Text="Буква диска"/>
        <ComboBox x:Name="LetterCombo" Margin="0,2,0,8"/>
        <StackPanel Orientation="Horizontal">
            <Button x:Name="MountButton" Content="Примонтировать" Click="MountClick" Height="30" Width="150" Margin="0,0,8,0"/>
            <Button x:Name="UnmountButton" Content="Отмонтировать" Click="UnmountClick" Height="30" Width="150"/>
        </StackPanel>

        <Separator Margin="0,12"/>

        <Border Background="#F3F3F3" Padding="8" CornerRadius="4">
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" Text="Не подключено."/>
        </Border>

        <Button x:Name="ShutdownButton" Content="Остановить движок" Click="ShutdownClick" Height="28" Margin="0,12,0,0"/>
    </StackPanel>
</Window>
