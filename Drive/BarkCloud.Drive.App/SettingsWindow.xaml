<ui:FluentWindow x:Class="BarkCloud.Drive.App.SettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Настройки" Height="620" Width="440"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 ResizeMode="NoResize"
                 WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Настройки" ShowMaximize="False" ShowMinimize="False"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20,8,20,8">
                <!-- Сессия -->
                <ui:Card>
                    <StackPanel>
                        <TextBlock Text="Аккаунт" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBlock x:Name="UsernameText" Text="—" Margin="0,0,0,8"/>
                        <ui:Button Content="Выйти" Click="LogoutClick"/>
                    </StackPanel>
                </ui:Card>

                <!-- Диск -->
                <ui:Card Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="Диск" FontWeight="SemiBold" Margin="0,0,0,8"/>

                        <TextBlock Text="Имя диска" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ui:TextBox x:Name="DriveNameBox" Grid.Column="0" Margin="0,0,8,0"/>
                            <ui:Button x:Name="RenameButton" Grid.Column="1" Content="Переименовать" Click="RenameClick"/>
                        </Grid>

                        <TextBlock Text="Буква диска" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="LetterCombo" Grid.Column="0" Margin="0,0,8,0"/>
                            <ui:Button x:Name="ChangeLetterButton" Grid.Column="1" Content="Сменить букву" Click="ChangeLetterClick"/>
                        </Grid>

                        <StackPanel Orientation="Horizontal">
                            <ui:Button x:Name="MountButton" Content="Примонтировать" Click="MountClick" Margin="0,0,8,0"/>
                            <ui:Button x:Name="UnmountButton" Content="Отмонтировать" Click="UnmountClick"/>
                        </StackPanel>

                        <TextBlock Text="Переименование и смена буквы кратко переподключают диск."
                                   Opacity="0.7" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </ui:Card>

                <!-- Кэш -->
                <ui:Card Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="Папка кэша" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ui:TextBox x:Name="CacheDirBox" Grid.Column="0" IsReadOnly="True" Margin="0,0,8,0"/>
                            <ui:Button Grid.Column="1" Content="Обзор…" Click="BrowseCacheClick"/>
                        </Grid>
                    </StackPanel>
                </ui:Card>

                <!-- Движок -->
                <ui:Card Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="Движок" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <ui:Button Content="Перезапустить движок" Click="RestartClick"/>
                    </StackPanel>
                </ui:Card>
            </StackPanel>
        </ScrollViewer>

        <TextBlock Grid.Row="2" x:Name="SettingsStatus" TextWrapping="Wrap" Opacity="0.8" Margin="20,4,20,16"/>
    </Grid>
</ui:FluentWindow>
