<ui:FluentWindow x:Class="BarkCloud.Drive.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:tray="clr-namespace:Wpf.Ui.Tray.Controls;assembly=Wpf.Ui.Tray"
                 xmlns:loc="clr-namespace:BarkCloud.Drive.App.Localization"
                 Title="BarkCloud Drive" Height="520" Width="420"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="BarkCloud Drive"/>

        <tray:NotifyIcon Grid.Row="0" x:Name="TrayIcon"
                         FocusOnLeftClick="True"
                         MenuOnRightClick="True"
                         TooltipText="BarkCloud Drive">
            <tray:NotifyIcon.Menu>
                <ContextMenu>
                    <MenuItem Header="{loc:Tr Tray_Open}" Click="ShowClick"/>
                    <Separator/>
                    <MenuItem Header="{loc:Tr Tray_Mount}" Click="MountClick"/>
                    <MenuItem Header="{loc:Tr Tray_Unmount}" Click="UnmountClick"/>
                    <Separator/>
                    <MenuItem Header="{loc:Tr Tray_Exit}" Click="ExitClick"/>
                </ContextMenu>
            </tray:NotifyIcon.Menu>
        </tray:NotifyIcon>

        <StackPanel Grid.Row="1" Margin="16,8,16,16">
            <!-- Предупреждение: движок не запущен -->
            <Border x:Name="EngineWarning" Visibility="Collapsed"
                    Background="#33FF8C00" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{loc:Tr Main_EngineWarningTitle}" FontWeight="Bold"/>
                    <TextBlock Text="{loc:Tr Main_EngineWarningText}"
                               TextWrapping="Wrap" Margin="0,2,0,8"/>
                    <ui:Button Content="{loc:Tr Main_StartEngine}" Appearance="Primary" Click="StartEngineClick"/>
                </StackPanel>
            </Border>

            <!-- Профиль -->
            <ui:Card>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Ellipse x:Name="AvatarEllipse" Grid.Column="0" Width="48" Height="48"
                             Margin="0,0,12,0" Visibility="Collapsed">
                        <Ellipse.Fill>
                            <ImageBrush x:Name="AvatarBrush" Stretch="UniformToFill"/>
                        </Ellipse.Fill>
                    </Ellipse>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="UsernameText" FontWeight="Bold" FontSize="16" Text="—"/>
                        <TextBlock x:Name="ServerText" Opacity="0.7" FontSize="12"/>
                    </StackPanel>
                </Grid>
            </ui:Card>

            <!-- Хранилище -->
            <ui:Card Margin="0,12,0,0">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="{loc:Tr Main_Storage}" FontWeight="SemiBold" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="UsageText" Text="—" Opacity="0.7" HorizontalAlignment="Right"/>
                    </Grid>
                    <Border Height="6" CornerRadius="3" ClipToBounds="True"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="UsageOtherCol" Width="0*"/>
                                <ColumnDefinition x:Name="UsageS3Col" Width="0*"/>
                                <ColumnDefinition x:Name="UsageFreeCol" Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <Border Grid.Column="1" Background="#9A4F1E"/>
                        </Grid>
                    </Border>
                    <StackPanel x:Name="UsageLegend" Orientation="Horizontal" Margin="0,8,0,0" Visibility="Collapsed">
                        <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" VerticalAlignment="Center"
                                   Fill="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <TextBlock x:Name="LegendOtherText" Margin="6,0,16,0" FontSize="12" VerticalAlignment="Center"/>
                        <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" VerticalAlignment="Center" Fill="#9A4F1E"/>
                        <TextBlock x:Name="LegendS3Text" Margin="6,0,16,0" FontSize="12" VerticalAlignment="Center"/>
                        <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" VerticalAlignment="Center"
                                   Fill="{DynamicResource ControlFillColorSecondaryBrush}"
                                   Stroke="{DynamicResource ControlStrokeColorDefaultBrush}" StrokeThickness="1"/>
                        <TextBlock x:Name="LegendFreeText" Margin="6,0,0,0" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="DriveStateText" Opacity="0.7" Margin="0,6,0,0" Text="—"/>
                </StackPanel>
            </ui:Card>

            <ui:Button x:Name="SettingsButton" Content="{loc:Tr Common_Settings}" HorizontalAlignment="Right"
                       Margin="0,16,0,0" Click="OpenSettingsClick"/>

            <TextBlock x:Name="StatusText" TextWrapping="Wrap" Opacity="0.7" Margin="0,12,0,0"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
