<ui:FluentWindow x:Class="BarkCloud.Drive.App.SettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:loc="clr-namespace:BarkCloud.Drive.App.Localization"
                 Title="{loc:Tr Common_Settings}" Height="620" Width="440"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 ResizeMode="NoResize"
                 WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{loc:Tr Common_Settings}" ShowMaximize="False" ShowMinimize="False"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20,8,20,8">
                <!-- Язык -->
                <ui:Card>
                    <StackPanel>
                        <TextBlock Text="{loc:Tr Common_Language}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <ComboBox x:Name="LanguageCombo" HorizontalAlignment="Left" Width="160" SelectionChanged="LanguageChanged"/>
                    </StackPanel>
                </ui:Card>

                <!-- Сессия -->
                <ui:Card Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="{loc:Tr Settings_Account}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBlock x:Name="UsernameText" Text="—" Margin="0,0,0,8"/>
                        <ui:Button Content="{loc:Tr Settings_Logout}" Click="LogoutClick"/>
                    </StackPanel>
                </ui:Card>

                <!-- Сервер -->
                <ui:Card Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="{loc:Tr Settings_Server}" FontWeight="SemiBold" Margin="0,0,0,8"/>

                        <TextBlock Text="{loc:Tr Common_ServerHost}" Margin="0,0,0,4"/>
                        <ui:TextBox x:Name="HostBox" Margin="0,0,0,10"/>

                        <TextBlock Text="{loc:Tr Common_Ports}" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                <TextBlock Text="Identity" Opacity="0.7" Margin="0,0,0,2"/>
                                <ui:TextBox x:Name="IdentityPortBox"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="4,0,4,0">
                                <TextBlock Text="Files" Opacity="0.7" Margin="0,0,0,2"/>
                                <ui:TextBox x:Name="FilesPortBox"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="4,0,0,0">
                                <TextBlock Text="Users" Opacity="0.7" Margin="0,0,0,2"/>
                                <ui:TextBox x:Name="UsersPortBox"/>
                            </StackPanel>
                        </Grid>

                        <CheckBox x:Name="AcceptCertCheck" Content="{loc:Tr Common_AcceptCert}" Margin="0,0,0,10"/>
                        <ui:Button Content="{loc:Tr Settings_ApplyAddress}" Click="ApplyServerClick"/>
                        <TextBlock Text="{loc:Tr Settings_ApplyAddressHint}"
                                   Opacity="0.7" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </ui:Card>

                <!-- Диск -->
                <ui:Card Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="{loc:Tr Settings_Drive}" FontWeight="SemiBold" Margin="0,0,0,8"/>

                        <TextBlock Text="{loc:Tr Common_DriveName}" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ui:TextBox x:Name="DriveNameBox" Grid.Column="0" Margin="0,0,8,0"/>
                            <ui:Button x:Name="RenameButton" Grid.Column="1" Content="{loc:Tr Settings_Rename}" Click="RenameClick"/>
                        </Grid>

                        <TextBlock Text="{loc:Tr Common_DriveLetter}" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="LetterCombo" Grid.Column="0" Margin="0,0,8,0"/>
                            <ui:Button x:Name="ChangeLetterButton" Grid.Column="1" Content="{loc:Tr Settings_ChangeLetter}" Click="ChangeLetterClick"/>
                        </Grid>

                        <StackPanel Orientation="Horizontal">
                            <ui:Button x:Name="MountButton" Content="{loc:Tr Tray_Mount}" Click="MountClick" Margin="0,0,8,0"/>
                            <ui:Button x:Name="UnmountButton" Content="{loc:Tr Tray_Unmount}" Click="UnmountClick"/>
                        </StackPanel>

                        <TextBlock Text="{loc:Tr Settings_DriveHint}"
                                   Opacity="0.7" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </ui:Card>

                <!-- Кэш -->
                <ui:Card Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="{loc:Tr Settings_Cache}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ui:TextBox x:Name="CacheDirBox" Grid.Column="0" IsReadOnly="True" Margin="0,0,8,0"/>
                            <ui:Button Grid.Column="1" Content="{loc:Tr Common_Browse}" Click="BrowseCacheClick"/>
                        </Grid>
                    </StackPanel>
                </ui:Card>

                <!-- Автозагрузка -->
                <ui:Card Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="{loc:Tr Settings_Autostart}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <CheckBox x:Name="AutostartAppCheck" Content="{loc:Tr Common_AutostartApp}" Click="AutostartAppClick" Margin="0,0,0,6"/>
                        <CheckBox x:Name="AutostartEngineCheck" Content="{loc:Tr Common_AutostartEngine}" Click="AutostartEngineClick"/>
                    </StackPanel>
                </ui:Card>

                <!-- Движок -->
                <ui:Card Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="{loc:Tr Settings_Engine}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <ui:Button Content="{loc:Tr Settings_RestartEngine}" Click="RestartClick"/>
                    </StackPanel>
                </ui:Card>
            </StackPanel>
        </ScrollViewer>

        <TextBlock Grid.Row="2" x:Name="SettingsStatus" TextWrapping="Wrap" Opacity="0.8" Margin="20,4,20,16"/>
    </Grid>
</ui:FluentWindow>
